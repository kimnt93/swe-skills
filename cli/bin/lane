#!/usr/bin/env bash
# swe-cli lane: headless one-shot, one card through a coding CLI (-p), then prove it. Interactive sessions
# in tmux worktrees are `swe-cli delegate`.
#
#   swe-cli lane run <cli> <top|mid|low> <card-file>    implement the card, then make verify
#   swe-cli lane review <author-cli> <card-file>        the other family breaks the diff
#
# The worker model comes from cli/models.yaml on every call. Evidence goes to .swe/ in the
# workspace: evidence.json (run) or review.json (review). Exit code = make verify.
# SWE_BASE (default origin/main) and SWE_AGENT_TIMEOUT (default 90m) tune a run.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
fleet="$here/main"
mode="${1:?usage: swe-cli lane run|review ...}"
plugin="$("$fleet" name)"
base="${SWE_BASE:-origin/main}"
ws="${HERMES_KANBAN_WORKSPACE:-$PWD}"
cd "$ws"
out="$ws/.swe"
mkdir -p "$out"
exclude="$(git rev-parse --git-path info/exclude)"
grep -qxF '.swe/' "$exclude" 2>/dev/null || echo '.swe/' >>"$exclude"
git fetch -q origin 2>/dev/null || { echo "swe-cli lane: cannot fetch origin: a stale base is worse than no work (swe-cli doctor)" >&2; exit 4; }

case "$mode" in
  run)
    lane="${2:?cli}"
    tier="${3:?tier}"
    card="${4:?card file}"
    brief="Start with the $plugin skill (/$plugin in Claude Code, /skill:$plugin in omp).
$(cat "$card")

Work only inside this worktree. Commit in small conventional commits.
Do not push to main. Done means: make verify exits 0 on the committed head."
    ;;
  review)
    author="${2:?author cli}"
    card="${3:?card file}"
    read -r lane tier <<<"$("$fleet" models reviewer "$author")"
    brief="You are reviewing, not fixing. Do not edit, commit or push.
Use the interrogate skill of the $plugin plugin on: git diff $base...HEAD
The change is meant to do this:
$(cat "$card")

Keep only findings you proved by running a command against this checkout.
For each: title, the exact command, the output it printed, the output the card requires.
Write the report to .swe/review.md. If nothing is proven, write: no verified findings."
    ;;
  *)
    echo "usage: swe-cli lane run|review ..." >&2
    exit 2
    ;;
esac

mapfile -t cmd < <("$fleet" models cmd "$lane" "$tier")
# the context policy: Claude Code reads its compaction point from the environment
while IFS= read -r setting; do [ -n "$setting" ] && export "$setting"; done < <("$fleet" context env "$lane" "$tier")
before="$(git status --porcelain)"
agent_rc=0
timeout "${SWE_AGENT_TIMEOUT:-90m}" "${cmd[@]}" "$brief" >"$out/$mode-agent.log" 2>&1 || agent_rc=$?
after="$(git status --porcelain)"
verify_rc=0
make verify >"$out/$mode-verify.log" 2>&1 || verify_rc=$?

python3 - "$out" "$mode" "$lane" "$tier" "$agent_rc" "$verify_rc" "$base" "$before" "$after" "${cmd[*]}" <<'EOF'
import json, subprocess, sys
out, mode, lane, tier, agent_rc, verify_rc, base, before, after, command = sys.argv[1:]
def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True).stdout.strip()
evidence = {
    "mode": mode, "cli": lane, "tier": tier, "command": command,
    "head": git("rev-parse", "HEAD"),
    "commits": git("log", "--oneline", f"{base}..HEAD").splitlines(),
    "changed_files": git("diff", "--name-only", f"{base}...HEAD").splitlines(),
    "uncommitted": git("status", "--porcelain").splitlines(),
    "agent_exit": int(agent_rc), "verify_exit": int(verify_rc),
    "verification": ["make verify"],
    "verify_tail": open(f"{out}/{mode}-verify.log").read()[-3000:],
}
if mode == "review":
    evidence["reviewer_edited_files"] = before != after
    try:
        evidence["report"] = open(f"{out}/review.md").read()[-6000:]
    except FileNotFoundError:
        evidence["report"] = None
name = "evidence.json" if mode == "run" else "review.json"
json.dump(evidence, open(f"{out}/{name}", "w"), indent=2)
EOF
exit "$verify_rc"
