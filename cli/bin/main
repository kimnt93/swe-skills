#!/usr/bin/env python3
"""swe-cli: Developer automation CLI for AI coding agents and playbooks.

Commands:
    swe-cli update [harness...] [--no-pull] [--dry-run]
                                         Update latest code, rebuild plugin, and reinstall into harnesses
    swe-cli delegate [options]           Delegate coding tasks via Orca, T3 Code, or direct CLI relays
    swe-cli playbooks                    List available playbooks and their slash commands
    swe-cli config [show|path|init]      Inspect or initialize configuration at config.json
    swe-cli doctor                       Health check for agent CLIs, Orca, T3 Code, git, and environment
    swe-cli models show                  Display configured agents, CLIs, models, and reasoning
    swe-cli models set <agent> [flags]   Configure an agent in config.json
    swe-cli models subagent <name>       Subagent model resolution (used by build system)
    swe-cli changelog show               Inspect project changelog history
    swe-cli changelog check <pr>         Verify that a PR includes a changelog entry
    swe-cli name                         Print the plugin name (default: swe)

Configuration:
    config.json resolution: $SWE_CONFIG -> ./config.json -> install_dir/config.json -> ~/.config/swe/config.json
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
from typing import Any, Dict, List, Optional

ROOT_DIR = Path(__file__).resolve().parents[2]

def get_plugin_name() -> str:
    if os.environ.get("PLUGIN_NAME"):
        return os.environ["PLUGIN_NAME"]
    env_file = ROOT_DIR / "plugin.env"
    if env_file.exists():
        for line in env_file.read_text(encoding="utf-8").splitlines():
            m = re.match(r"^\s*PLUGIN_NAME\s*\??=\s*(\S+)", line)
            if m:
                return m.group(1)
    return "swe"

def get_config_search_paths() -> List[Path]:
    paths: List[Path] = []
    name = get_plugin_name()
    env_var = f"{name.upper()}_CONFIG"
    if os.environ.get(env_var):
        paths.append(Path(os.environ[env_var]))
    if os.environ.get("SWE_CONFIG"):
        paths.append(Path(os.environ["SWE_CONFIG"]))

    paths.append(Path("./config.json"))
    paths.append(ROOT_DIR / "config.json")
    paths.append(ROOT_DIR / f"dist/{name}/config.json")
    paths.append(ROOT_DIR / "config.example.json")

    home = Path.home()
    if sys.platform == "win32":
        appdata = os.environ.get("APPDATA")
        if appdata:
            paths.append(Path(appdata) / name / "config.json")
        paths.append(home / ".config" / name / "config.json")
    elif sys.platform == "darwin":
        paths.append(home / "Library" / "Application Support" / name / "config.json")
        paths.append(home / ".config" / name / "config.json")
    else:
        xdg_config = os.environ.get("XDG_CONFIG_HOME")
        if xdg_config:
            paths.append(Path(xdg_config) / name / "config.json")
        paths.append(home / ".config" / name / "config.json")
    return paths

def resolve_active_config_path() -> Optional[Path]:
    for p in get_config_search_paths():
        if p.is_file():
            return p
    return None

def load_config() -> Dict[str, Any]:
    cfg_path = resolve_active_config_path()
    if cfg_path and cfg_path.is_file():
        try:
            with open(cfg_path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_config(data: Dict[str, Any], target_path: Optional[Path] = None) -> Path:
    if target_path is None:
        target_path = resolve_active_config_path()
    if target_path is None:
        name = get_plugin_name()
        target_path = Path.home() / ".config" / name / "config.json"
    target_path.parent.mkdir(parents=True, exist_ok=True)
    with open(target_path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    return target_path

# ==============================================================================
# Commands
# ==============================================================================

def cmd_name() -> int:
    print(get_plugin_name())
    return 0

def cmd_update(argv: List[str]) -> int:
    parser = argparse.ArgumentParser(description="Update plugin to latest version, rebuild, and reinstall.")
    parser.add_argument("harnesses", nargs="*", help="Specific harnesses to install into (defaults to detected)")
    parser.add_argument("--no-pull", action="store_true", help="Skip git pull from remote")
    parser.add_argument("--branch", default="main", help="Git branch to pull (default: main)")
    parser.add_argument("--dry-run", action="store_true", help="Preview update steps without executing")
    args = parser.parse_args(argv)

    print(f"==> Updating {get_plugin_name()}...")

    # 1. Pull latest code if git repository
    git_dir = ROOT_DIR / ".git"
    if git_dir.is_dir() and not args.no_pull:
        if args.dry_run:
            print(f"[dry-run] Would execute: git pull origin {args.branch} in {ROOT_DIR}")
        else:
            print(f"Pulling latest commits from origin/{args.branch}...")
            res = subprocess.run(["git", "pull", "origin", args.branch], cwd=str(ROOT_DIR), check=False)
            if res.returncode != 0:
                print(f"Warning: git pull exited with code {res.returncode}. Continuing with build...")

    # 2. Build the plugin
    build_script = ROOT_DIR / "scripts/build.py"
    if not build_script.exists():
        print(f"Error: {build_script} not found.", file=sys.stderr)
        return 1

    if args.dry_run:
        print(f"[dry-run] Would execute: python3 {build_script}")
    else:
        print("Rebuilding plugin...")
        res = subprocess.run([sys.executable, str(build_script)], cwd=str(ROOT_DIR), check=False)
        if res.returncode != 0:
            print("Error: build failed.", file=sys.stderr)
            return res.returncode

    # 3. Reinstall into harnesses
    name = get_plugin_name()
    installer = ROOT_DIR / f"dist/{name}/scripts/install.py"
    if not installer.exists():
        installer = ROOT_DIR / "scripts/install.py"

    install_cmd = [sys.executable, str(installer), "install"]
    if args.harnesses:
        for h in args.harnesses:
            install_cmd.extend(["--agent", h])
    else:
        install_cmd.append("--detected")

    if args.dry_run:
        install_cmd.append("--dry-run")
        print(f"[dry-run] Would execute: {' '.join(install_cmd)}")
    else:
        print("Reinstalling into agent harnesses...")
        res = subprocess.run(install_cmd, cwd=str(ROOT_DIR), check=False)
        if res.returncode != 0:
            print("Warning: installation encountered errors.", file=sys.stderr)

    # 4. Link CLI executable
    bin_dir = Path.home() / ".local/bin"
    bin_target = bin_dir / f"{name}-cli"
    if not args.dry_run:
        bin_dir.mkdir(parents=True, exist_ok=True)
        main_script = ROOT_DIR / "cli/bin/main"
        if bin_target.exists() or bin_target.is_symlink():
            bin_target.unlink()
        bin_target.symlink_to(main_script)
        print(f"✓ Linked {bin_target} -> {main_script}")

    print(f"✓ {name} successfully updated to latest version.")
    return 0

def cmd_delegate(argv: List[str]) -> int:
    script_candidates = [
        ROOT_DIR / "src/skills/delegate/scripts/delegate.py",
        ROOT_DIR / f"dist/{get_plugin_name()}/skills/delegate/scripts/delegate.py"
    ]
    script_path = None
    for cand in script_candidates:
        if cand.exists():
            script_path = cand
            break

    if not script_path:
        print("Error: delegate.py runner not found.", file=sys.stderr)
        return 1

    proc = subprocess.run([sys.executable, str(script_path)] + argv)
    return proc.returncode

def cmd_playbooks() -> int:
    playbooks = [
        ("playbook-build", "DEFAULT. Issue, architect plan, PRs, reviewer checks them against the plan and fixes, CTO merges"),
        ("playbook-quick", "Only when named. Issues, PRs, CTO merges on mechanical checks only; no review"),
        ("playbook-plan", "CTO card, architect plan comment, sent back to CTO, accept, stop (nothing built)"),
        ("playbook-review", "Review one PR and post one verdict comment; changes nothing"),
        ("playbook-ship", "One PR: review and fix (3 rounds), merge and close its issue, or stop"),
    ]
    name = get_plugin_name()
    print(f"=== Available Playbooks (invoke via /{name}:<playbook>) ===")
    print(f"{'Playbook':<22} | {'Slash Command':<24} | {'Description'}")
    print("-" * 80)
    for pb_name, desc in playbooks:
        cmd_str = f"/{name}:{pb_name}"
        print(f"{pb_name:<22} | {cmd_str:<24} | {desc}")
    print("A request that names a playbook follows it; with none named, playbook-build runs.")
    return 0

def cmd_config(argv: List[str]) -> int:
    sub = argv[0] if argv else "show"
    if sub == "path":
        p = resolve_active_config_path()
        if p:
            print(p)
            return 0
        else:
            print("No config.json found in search paths.", file=sys.stderr)
            return 1
    elif sub == "init":
        target = Path(argv[1]) if len(argv) > 1 else Path.home() / f".config/{get_plugin_name()}/config.json"
        example = ROOT_DIR / "config.example.json"
        default_data = {}
        if example.exists():
            try:
                default_data = json.loads(example.read_text(encoding="utf-8"))
            except Exception:
                pass
        saved_path = save_config(default_data, target)
        print(f"✓ Initialized config at {saved_path}")
        return 0
    else:  # show
        active_path = resolve_active_config_path()
        cfg = load_config()
        print(f"Active config path: {active_path or 'None (using defaults)'}")
        print(json.dumps(cfg, indent=2))
        return 0

def cmd_doctor() -> int:
    name = get_plugin_name()
    print(f"=== {name}-cli Doctor Health Check ===")

    # 1. Check tools
    for tool in ("git", "gh", "python3"):
        hit = shutil.which(tool)
        status = f"✓ Found: {hit}" if hit else "✗ Missing"
        print(f"  • {tool:<10}: {status}")

    # 2. Check orchestration engines
    t3_hit = shutil.which("t3") or shutil.which("t3code") or (Path.home() / ".t3/bin/t3").exists()
    print(f"  • {'t3 code':<10}: {'✓ Available' if t3_hit else '○ Not found (optional)'}")

    orca_hit = shutil.which("orca-ide") or shutil.which("orca-dev") or os.environ.get("ORCA_CLI_COMMAND")
    print(f"  • {'orca':<10}: {'✓ Available' if orca_hit else '○ Not found (optional)'}")

    # 3. Check agent CLIs
    script = ROOT_DIR / "src/skills/delegate/scripts/discover_agents.py"
    if script.exists():
        print("\nAgent CLIs:")
        subprocess.run([sys.executable, str(script)])

    # 4. Check config
    cfg_path = resolve_active_config_path()
    print(f"\nConfiguration: {cfg_path or 'None found'}")
    return 0

def cmd_models(argv: List[str]) -> int:
    sub = argv[0] if argv else "show"
    if sub == "subagent":
        agent_name = argv[1] if len(argv) > 1 else ""
        cfg = load_config()
        agents = cfg.get("agents", {})
        if agent_name == "worker":
            target = agents.get("worker") or agents.get("developer-senior") or agents.get("developer")
            if isinstance(target, dict):
                print(target.get("model", "claude-sonnet-5-5"))
            elif isinstance(target, str):
                print(target)
            else:
                print("claude-sonnet-5-5")
        elif agent_name == "adversary":
            target = agents.get("adversary") or agents.get("reviewer-senior") or agents.get("reviewer")
            if isinstance(target, dict):
                print(target.get("model", "claude-sonnet-5-5"))
            elif isinstance(target, str):
                print(target)
            else:
                print("claude-sonnet-5-5")
        else:
            if agent_name in agents and isinstance(agents[agent_name], dict):
                print(agents[agent_name].get("model", "inherit"))
            else:
                print("inherit")
        return 0

    if sub == "set":
        parser = argparse.ArgumentParser(description="Set agent parameters in config.json")
        parser.add_argument("agent", help="Agent role name (e.g. developer-junior)")
        parser.add_argument("--cli", "-c", help="CLI name (codex, claude, omp, etc.)")
        parser.add_argument("--model", "-m", help="Model slug")
        parser.add_argument("--reasoning", "-r", help="Reasoning effort")
        args = parser.parse_args(argv[1:])

        cfg = load_config()
        agents = cfg.setdefault("agents", {})
        agent_dict = agents.setdefault(args.agent, {})
        if args.cli is not None:
            agent_dict["cli"] = args.cli
        if args.model is not None:
            agent_dict["model"] = args.model
        if args.reasoning is not None:
            if args.reasoning == "":
                agent_dict.pop("reasoning", None)
            else:
                agent_dict["reasoning"] = args.reasoning
        saved = save_config(cfg)
        print(f"✓ Updated agent '{args.agent}' in {saved}")
        return 0

    if sub == "cmd":
        agent_name = argv[1] if len(argv) > 1 else "developer-junior"
        cfg = load_config()
        agents = cfg.get("agents", {})
        spec = agents.get(agent_name, {})
        cli = spec.get("cli", "codex")
        model = spec.get("model", "o3-mini")
        reasoning = spec.get("reasoning")
        
        args_out = [cli]
        if cli == "codex":
            args_out.extend(["exec", "--model", model])
            if reasoning:
                args_out.extend(["--reasoning-effort", reasoning])
            args_out.append("--dangerously-skip-permissions")
        elif cli == "claude":
            args_out.extend(["-p", "--model", model])
            if reasoning:
                args_out.extend(["--effort", reasoning])
            args_out.append("--permission-mode bypassPermissions")
        elif cli == "omp":
            args_out.extend(["--prompt", "--model", model])
            if reasoning:
                args_out.extend(["--thinking", reasoning])
            args_out.append("--approval-mode yolo")
        else:
            args_out.extend(["-p", "--model", model])
        for a in args_out:
            print(a)
        return 0

    # show
    cfg = load_config()
    print("=== Configured Agents ===")
    agents = cfg.get("agents", {})
    if not agents:
        print("No agents defined in config.json. Using defaults.")
    else:
        for name, spec in agents.items():
            if isinstance(spec, dict):
                cli = spec.get("cli", "auto")
                m = spec.get("model", "default")
                r = spec.get("reasoning", "none")
                print(f"  • {name:<20}: cli={cli:<10} model={m:<24} reasoning={r}")
    return 0

def cmd_changelog(argv: List[str]) -> int:
    sub = argv[0] if argv else "show"
    ch_path = ROOT_DIR / "CHANGELOG.md"
    if not ch_path.exists():
        print("No CHANGELOG.md found in repository root.", file=sys.stderr)
        return 1

    if sub == "check":
        pr = argv[1] if len(argv) > 1 else ""
        content = ch_path.read_text(encoding="utf-8")
        if f"#{pr}" in content:
            print(f"✓ Changelog entry found for PR #{pr}")
            return 0
        else:
            print(f"✗ No changelog entry found for PR #{pr}")
            return 1
    else:
        print(ch_path.read_text(encoding="utf-8"))
        return 0

def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__)
        return 0

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    elif cmd == "name":
        return cmd_name()
    elif cmd == "update":
        return cmd_update(args)
    elif cmd == "delegate":
        return cmd_delegate(args)
    elif cmd in ("playbooks", "playbook", "list"):
        return cmd_playbooks()
    elif cmd == "config":
        return cmd_config(args)
    elif cmd == "doctor":
        return cmd_doctor()
    elif cmd in ("models", "model"):
        return cmd_models(args)
    elif cmd == "changelog":
        return cmd_changelog(args)
    else:
        print(f"Unknown command: {cmd}\n", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())
