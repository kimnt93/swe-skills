#!/usr/bin/env python3
"""fleet delegate: a project's orchestrator (any CLI agent) starts coding CLIs, one git worktree per card.

Sessions run in tmux or, with launcher: orca in models.yaml, as Orca terminals you can watch in the Orca UI.
A project is a directory holding one or more repo clones; worktrees live in <dir>/.wt/<repo>/<branch>.

    fleet delegate start <project> <card> --files a,b --goal "..." [--repo name] [--branch type/n-slug] [--issue N]
                         [--risk standard] [--cli claude|codex|omp] [--tier mid] [--brief-file F] [--dry-run]
    fleet orchestrate <project> [--cli X] [--tier T] [--dry-run]   the project's orchestrator, in its directory
    fleet delegate review <project> <card> [--cli omp] [--tier top] [--dry-run]    the other CLI, read-only
    fleet delegate status <project> [card] [--fetch]      JSON for one card, a table for the project
    fleet delegate send <project> <card> <text...>        type a message into the card's session
    fleet delegate sync-branch [--verify]                 in a worktree: fetch, rebase on origin/main, make verify
    fleet delegate scope <project> <card>                 files changed outside the card's list (exit 8 if any)
    fleet delegate stop <project> <card>                  end the session, keep the worktree
    fleet delegate cleanup <project> <card> [--force]     after the merge: session, worktree, branch, record

Rules it enforces: the fetch must succeed (never a stale base); a card whose files overlap an open
card, in this project or in any other project that clones the same GitHub repo, or that touches a hotspot
another card holds, is refused (exit 5); a branch name already taken, locally, on origin or by another
project's card, is refused (exit 11); the base is origin/main at the moment the card starts; the central
clone is never edited. With tmux: tmux attach -t <project>-<card>.
Environment: FLEET_STATE (default ~/.fleet), FLEET_WORKTREES (default <project dir>/.wt; worktrees go in <it>/<repo>/<branch>),
CLAUDE_JSON (default ~/.claude.json), FLEET_READY_TIMEOUT (default 90 seconds).
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
FLEET_DIR = HERE.parent
_loader = importlib.machinery.SourceFileLoader("fleetmod", str(HERE / "fleet"))
_spec = importlib.util.spec_from_loader("fleetmod", _loader)
fleet = importlib.util.module_from_spec(_spec)
_loader.exec_module(fleet)

STATE = Path(os.environ.get("FLEET_STATE", Path.home() / ".fleet"))
CLAUDE_JSON = Path(os.environ.get("CLAUDE_JSON", Path.home() / ".claude.json"))
READY_TIMEOUT = int(os.environ.get("FLEET_READY_TIMEOUT", "90"))
ID_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
BRANCH_RE = re.compile(r"^(feat|fix|chore|docs|refactor|test|perf|ci)/[a-z0-9]+(-[a-z0-9]+)*$")
# dialogs a CLI can open before its prompt: text in the pane -> keys that accept it
DIALOGS = (("Trust and continue", ["Enter"]), ("Do you trust the contents", ["Enter"]),
           ("Yes, I trust this folder", ["Down", "Enter"]), ("Yes, I accept", ["Down", "Enter"]),
           ("Trust this folder", ["Enter"]))
# the last line an agent prints; the brief's own examples (placeholders in <>) must not match
OUTCOME_RE = re.compile(r"^[\s●⏺•*-]*((?:CARD DONE [0-9a-f]{7,40} \S+|CARD BLOCKED [^<\s][^\n]*|REVIEW DONE [0-9a-f]{7,40} \d+ [^\n]*|REVIEW BLOCKED [^<\s][^\n]*))\s*$", re.M)
NO_PROMPT = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}


def die(code: int, message: str):
    print(f"fleet delegate: {message}", file=sys.stderr)
    sys.exit(code)


def sh(args: list[str], cwd: Path | None = None, check: bool = False, timeout: int = 120) -> subprocess.CompletedProcess:
    result = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=NO_PROMPT)
    if check and result.returncode != 0:
        die(1, f"{' '.join(args[:4])} failed: {(result.stderr or result.stdout).strip()[:400]}")
    return result


def git(repo: Path, *args: str, check: bool = False) -> subprocess.CompletedProcess:
    return sh(["git", "-C", str(repo), *args], check=check)


# ------------------------------------------------------------------------------------------------ state


def record_path(project: str, card: str) -> Path:
    return STATE / project / f"{card}.json"


def load_record(project: str, card: str) -> dict:
    path = record_path(project, card)
    if not path.exists():
        die(2, f"no card {card!r} in project {project!r} ({path} does not exist)")
    return json.loads(path.read_text(encoding="utf-8"))


def save_record(record: dict) -> None:
    path = record_path(record["project"], record["card"])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")


def records(project: str) -> list[dict]:
    folder = STATE / project
    return [json.loads(p.read_text(encoding="utf-8")) for p in sorted(folder.glob("*.json"))] if folder.is_dir() else []


def all_records() -> list[dict]:
    return [json.loads(p.read_text(encoding="utf-8")) for p in sorted(STATE.glob("*/*.json"))] if STATE.is_dir() else []


def project_of(name: str) -> dict:
    projects = fleet.load_projects()
    if name not in projects:
        die(2, f"no project {name!r} in {fleet.PROJECTS}")
    return fleet.project_view(name, projects[name])


def repo_of(project: dict, wanted: str | None) -> tuple[str, dict]:
    repos = project["repos"]
    if not wanted:
        if len(repos) != 1:
            die(2, f"project {project['name']} has several repos ({', '.join(repos)}): pass --repo <name>")
        wanted = next(iter(repos))
    if wanted not in repos:
        die(2, f"project {project['name']} has no repo {wanted!r} (it has: {', '.join(repos)})")
    return wanted, repos[wanted]


def same_repo(record: dict, project_name: str, repo: str, github: str) -> bool:
    """A card works on the same code when it is in the same clone, or another project clones the same GitHub repo."""
    if record["project"] == project_name:
        return record.get("repo", "") == repo
    return bool(github) and record.get("github") == github


# ------------------------------------------------------------------------------------------------ overlap


def norm(path: str) -> str:
    path = path.strip().removeprefix("./")
    cut = re.search(r"[*?\[]", path)
    if cut:
        path = path[: cut.start()].rsplit("/", 1)[0] if "/" in path[: cut.start()] else ""
    return path.rstrip("/")


def overlap(a: str, b: str) -> bool:
    a, b = norm(a), norm(b)
    return a == b or a == "" or b == "" or a.startswith(b + "/") or b.startswith(a + "/")


def conflicts(files: list[str], hotspots: list[str], others: list[dict]) -> list[str]:
    found = []
    for other in others:
        for mine in files:
            for theirs in other["files"]:
                if overlap(mine, theirs):
                    found.append(f"card {other['card']} already holds {theirs} (you listed {mine})")
        for spot in hotspots:
            if any(overlap(spot, f) for f in files) and any(overlap(spot, f) for f in other["files"]):
                found.append(f"hotspot {spot} is held by card {other['card']}")
    return sorted(set(found))


# ------------------------------------------------------------------------------------------------ tmux


def tmux(*args: str) -> subprocess.CompletedProcess:
    return sh(["tmux", *args])


def orca(*args: str) -> subprocess.CompletedProcess:
    return sh(["orca-ide", *args, "--json"], timeout=60)


def find_key(data, key: str):
    if isinstance(data, dict):
        if key in data:
            return data[key]
        for value in data.values():
            found = find_key(value, key)
            if found is not None:
                return found
    elif isinstance(data, list):
        for item in data:
            found = find_key(item, key)
            if found is not None:
                return found
    return None


def launcher_name() -> str:
    return os.environ.get("FLEET_LAUNCHER") or fleet.load()["launcher"]


def handles() -> dict:
    path = STATE / "orca-handles.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}


def remember_handle(session: str, handle: str | None) -> None:
    data = handles()
    if handle:
        data[session] = handle
    else:
        data.pop(session, None)
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "orca-handles.json").write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def alive(session: str) -> bool:
    if launcher_name() == "orca":
        handle = handles().get(session)
        if not handle:
            return False
        shown = orca("terminal", "show", "--terminal", handle)
        return shown.returncode == 0
    return tmux("has-session", "-t", session).returncode == 0


def pane(session: str, lines: int = 200) -> str:
    if launcher_name() == "orca":
        handle = handles().get(session)
        if not handle:
            return ""
        read = orca("terminal", "read", "--terminal", handle, "--screen")
        try:
            return str(find_key(json.loads(read.stdout), "text") or find_key(json.loads(read.stdout), "screen") or "")
        except ValueError:
            return read.stdout
    return tmux("capture-pane", "-p", "-t", session, "-S", f"-{lines}").stdout


def send_keys(session: str, *keys: str) -> None:
    if launcher_name() == "orca":
        handle = handles().get(session)
        for key in keys:
            if key == "Enter":
                orca("terminal", "send", "--terminal", handle, "--enter")
            elif key == "Down":
                orca("terminal", "send", "--terminal", handle, "--text", "\x1b[B")
        return
    tmux("send-keys", "-t", session, *keys)


def open_session(session: str, cwd: str, line: str) -> None:
    if launcher_name() == "orca":
        folder = Path(cwd)
        made = orca("terminal", "create", "--worktree", f"path:{cwd}", "--title", session, "--command", line)
        if made.returncode != 0:
            die(1, f"orca-ide terminal create failed: {(made.stderr or made.stdout).strip()[:300]} "
                   f"(is {folder} a worktree of a repo registered in Orca? fleet project sync)")
        handle = find_key(json.loads(made.stdout), "handle")
        if not handle:
            die(1, f"orca-ide terminal create returned no handle: {made.stdout[:300]}")
        remember_handle(session, str(handle))
        return
    made = tmux("new-session", "-d", "-s", session, "-x", "200", "-y", "50", "-c", cwd, line)
    if made.returncode != 0:
        die(1, f"tmux new-session failed: {made.stderr.strip()}")
    tmux("set-option", "-t", session, "remain-on-exit", "on")


def close_session(session: str) -> None:
    if not session or not alive(session):
        return
    if launcher_name() == "orca":
        orca("terminal", "close", "--terminal", handles()[session])
        remember_handle(session, None)
    else:
        tmux("kill-session", "-t", session)


def attach_hint(session: str) -> str:
    return f"watch it in Orca (terminal titled {session})" if launcher_name() == "orca" else f"attach: tmux attach -t {session}"


def wait_ready(session: str, cli: str, marker: str) -> None:
    deadline = time.time() + READY_TIMEOUT
    while time.time() < deadline:
        if not alive(session):
            die(9, f"session {session} ended before the {cli} prompt appeared")
        text = pane(session, 60)
        for needle, keys in DIALOGS:
            if needle in text:
                send_keys(session, *keys)
                time.sleep(1.5)
                text = ""
                break
        if marker in text:
            return
        time.sleep(1)
    die(9, f"{cli} did not show its prompt ({marker!r}) in {READY_TIMEOUT}s: {attach_hint(session)}")


def paste(session: str, text: str) -> None:
    if launcher_name() == "orca":
        orca("terminal", "send", "--terminal", handles()[session], "--text", text, "--enter")
        return
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False, encoding="utf-8") as handle:
        handle.write(text)
    buffer = f"fleet-{session}"
    tmux("load-buffer", "-b", buffer, handle.name)
    tmux("paste-buffer", "-d", "-b", buffer, "-t", session)
    os.unlink(handle.name)
    time.sleep(0.6)
    tmux("send-keys", "-t", session, "Enter")


def pretrust_claude(path: str) -> None:
    """Claude Code asks once per folder whether it is trusted; a worktree we create is the project's own."""
    try:
        data = json.loads(CLAUDE_JSON.read_text(encoding="utf-8")) if CLAUDE_JSON.exists() else {}
    except ValueError:
        return
    entry = data.setdefault("projects", {}).setdefault(path, {})
    if entry.get("hasTrustDialogAccepted"):
        return
    entry["hasTrustDialogAccepted"] = True
    backup = CLAUDE_JSON.with_name(CLAUDE_JSON.name + ".fleet-bak")
    if CLAUDE_JSON.exists() and not backup.exists():
        shutil.copy2(CLAUDE_JSON, backup)
    temp = CLAUDE_JSON.with_name(CLAUDE_JSON.name + ".fleet-tmp")
    temp.write_text(json.dumps(data, indent=2), encoding="utf-8")
    os.replace(temp, CLAUDE_JSON)


def command_line(cfg: dict, cli: str, tier: str) -> str:
    command = fleet.argv(cfg, cli, tier, interactive=True)
    env = dict(line.split("=", 1) for line in sh([sys.executable, str(HERE / "fleet"), "context", "env", cli, tier]).stdout.split() if "=" in line)
    env["PATH"] = os.environ.get("PATH", "")
    return "env " + " ".join(f"{k}={shlex.quote(v)}" for k, v in env.items()) + " " + shlex.join(command)


def launch(cfg: dict, cwd: str, session: str, cli: str, tier: str, brief: str, dry: bool, brief_name: str = "brief.md") -> None:
    """Open the session in cwd, wait for the CLI's prompt, then hand it the brief (a file, named in one line)."""
    line = command_line(cfg, cli, tier)
    where = launcher_name()
    if dry:
        print(f"would run ({where}): {session} in {cwd}: {line}")
        print(f"would hand over the brief ({len(brief.splitlines())} lines) in {cwd}/.fleet/{brief_name}")
        return
    folder = Path(cwd) / ".fleet"
    folder.mkdir(parents=True, exist_ok=True)
    (folder / brief_name).write_text(brief, encoding="utf-8")
    if cli == "claude":
        pretrust_claude(cwd)
    open_session(session, cwd, line)
    wait_ready(session, cli, str((cfg["clis"].get(cli) or {}).get("ready", "")))
    paste(session, f"Read .fleet/{brief_name} and follow it exactly. It is your whole task.")


def render(name: str, **values) -> str:
    return (FLEET_DIR / name).read_text(encoding="utf-8").format(**values)


def start_command(plugin: str, cli: str) -> str:
    return {"claude": f"/{plugin} in Claude Code", "codex": f"${plugin} in Codex",
            "omp": f"/skill:{plugin} in oh-my-pi"}[cli]


# ------------------------------------------------------------------------------------------------ commands


def flags_of(args: list[str], booleans: set[str]) -> tuple[list[str], dict[str, str], set[str]]:
    positional, values, switches = [], {}, set()
    i = 0
    while i < len(args):
        a = args[i]
        if a in booleans:
            switches.add(a)
        elif a.startswith("--"):
            if i + 1 >= len(args):
                die(2, f"{a} needs a value")
            values[a] = args[i + 1]
            i += 1
        else:
            positional.append(a)
        i += 1
    return positional, values, switches


def cmd_start(args: list[str]) -> int:
    pos, flag, switch = flags_of(args, {"--dry-run"})
    if len(pos) != 2 or "--files" not in flag or not ("--goal" in flag or "--brief-file" in flag):
        die(2, "usage: fleet delegate start <project> <card> --files a,b --goal \"...\" [--branch type/n-slug] "
               "[--issue N] [--repo name] [--risk standard] [--cli claude|codex|omp] [--tier mid] [--brief-file F] [--dry-run]")
    name, card = pos
    dry = "--dry-run" in switch
    if not ID_RE.match(card):
        die(2, f"card id {card!r} must match {ID_RE.pattern}")
    cfg, project = fleet.load(), project_of(name)
    cli = flag.get("--cli", project["cli"])
    tier = flag.get("--tier", "mid")
    if cli not in cfg["clis"]:
        die(2, f"unknown cli {cli!r}")
    if tier not in fleet.TIERS:
        die(2, f"tier must be one of {', '.join(fleet.TIERS)}")
    files = [f.strip() for f in flag["--files"].split(",") if f.strip()]
    if not files or any(f.startswith("/") or ".." in f.split("/") for f in files):
        die(2, "--files must be repo-relative paths (a file, a directory/ or a glob)")
    branch = flag.get("--branch") or f"feat/{card}"
    if not BRANCH_RE.match(branch):
        die(2, f"branch {branch!r} must look like <type>/<slug>, type one of feat|fix|chore|docs|refactor|test|perf|ci")
    if record_path(name, card).exists():
        die(2, f"card {card} already exists in {name}: stop and cleanup it first")
    repo_name, repo_spec = repo_of(project, flag.get("--repo"))
    github = repo_spec.get("github", "")
    others = [r for r in all_records() if same_repo(r, name, repo_name, github)]
    clash = conflicts(files, repo_spec["hotspots"], others)
    if clash:
        die(5, "refused, the work overlaps open cards (wait for their merge, then cleanup, or change the files):\n  - " + "\n  - ".join(clash))
    taken = [r for r in others if r["branch"] == branch]
    if taken:
        die(11, f"branch {branch} is already used by card {taken[0]['card']} of project {taken[0]['project']}: pick another --branch")
    repo = Path(repo_spec["path"])
    if not (repo / ".git").exists():
        die(2, f"{repo} is not a git clone: fleet project sync {name}")
    fetched = git(repo, "fetch", "origin", "--prune")
    if fetched.returncode != 0:
        die(4, f"cannot fetch origin for {name}: {fetched.stderr.strip()[:300]}\n"
               "  a stale base is worse than no work: fix the credentials (fleet doctor) and retry")
    base = git(repo, "rev-parse", "origin/main", check=True).stdout.strip()
    if git(repo, "branch", "--show-current").stdout.strip() == "main" and not git(repo, "status", "--porcelain").stdout.strip():
        git(repo, "merge", "--ff-only", "origin/main")
    if git(repo, "rev-parse", "--verify", "-q", f"refs/heads/{branch}").returncode == 0 \
            or git(repo, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}").returncode == 0:
        die(11, f"branch {branch} already exists in {repo_name} (locally or on origin): pick another --branch")
    root = (Path(os.environ["FLEET_WORKTREES"]) if os.environ.get("FLEET_WORKTREES") else Path(project["dir"]) / ".wt") / repo_name
    worktree = root / branch.replace("/", "-")
    session = f"{name}-{card}"
    if alive(session):
        die(2, f"tmux session {session} already exists")
    goal = Path(flag["--brief-file"]).read_text(encoding="utf-8").strip() if "--brief-file" in flag else flag["--goal"]
    record = {"project": name, "repo": repo_name, "repo_path": str(repo), "github": github, "card": card, "branch": branch, "worktree": str(worktree), "session": session,
              "cli": cli, "tier": tier, "files": files, "base": base, "risk": flag.get("--risk", "standard"),
              "issue": flag.get("--issue", "-"), "goal": goal, "status": "running", "started": int(time.time())}
    spots = [h for h in repo_spec["hotspots"] if any(overlap(h, f) for f in files)]
    brief = render("brief.md", plugin=fleet.plugin_name(), start=start_command(fleet.plugin_name(), cli), card=card,
                   project=name, repo=repo_name, goal=goal, risk=record["risk"], issue=record["issue"], branch=branch, base=base[:12],
                   files=", ".join(files), worktree=worktree, fleet=HERE / "fleet",
                   hotspots=("hotspots you hold: " + ", ".join(spots) + " (no other card may touch them until yours merges)\n") if spots else "")
    if dry:
        print(f"would run: git -C {repo} worktree add -b {branch} {worktree} {base[:12]}")
    else:
        root.mkdir(parents=True, exist_ok=True)
        made = git(repo, "worktree", "add", "-b", branch, str(worktree), "origin/main")
        if made.returncode != 0:
            die(1, f"git worktree add failed: {made.stderr.strip()[:300]}")
        exclude = git(worktree, "rev-parse", "--git-path", "info/exclude").stdout.strip()
        exclude_path = Path(exclude) if os.path.isabs(exclude) else worktree / exclude
        exclude_path.parent.mkdir(parents=True, exist_ok=True)
        with exclude_path.open("a", encoding="utf-8") as handle:
            handle.write(".fleet/\n")
        save_record(record)
    launch(cfg, record["worktree"], session, cli, tier, brief, dry)
    if not dry:
        print(json.dumps({k: record[k] for k in ("project", "repo", "card", "branch", "worktree", "session", "cli", "base")}, indent=2))
        print(attach_hint(session))
    return 0


def cmd_review(args: list[str]) -> int:
    pos, flag, switch = flags_of(args, {"--dry-run"})
    if len(pos) != 2:
        die(2, "usage: fleet delegate review <project> <card> [--cli omp] [--tier top] [--dry-run]")
    name, card = pos
    cfg = fleet.load()
    record = load_record(name, card)
    other, tier = (flag.get("--cli"), flag.get("--tier"))
    if not other:
        reviewer = cfg["reviewers"][record["cli"]]
        other, tier = reviewer["cli"], flag.get("--tier", reviewer["tier"])
    tier = tier or "top"
    if other not in cfg["clis"]:
        die(2, f"unknown cli {other!r}")
    session = f"{name}-{card}-review"
    if alive(session) and "--dry-run" not in switch:
        die(2, f"tmux session {session} already exists")
    brief = render("brief-review.md", plugin=fleet.plugin_name(), start=start_command(fleet.plugin_name(), other),
                   card=card, project=name, goal=record["goal"], base_ref=record["base"][:12])
    launch(cfg, record["worktree"], session, other, tier, brief, "--dry-run" in switch, "brief-review.md")
    if "--dry-run" not in switch:
        record["review_session"] = session
        save_record(record)
        print(f"reviewing {card} with {other} ({tier}): {attach_hint(session)}")
    return 0


def card_status(record: dict, fetch: bool) -> dict:
    cfg = fleet.load()
    worktree = Path(record["worktree"])
    if fetch:
        git(worktree, "fetch", "origin", "--prune")
    exists = worktree.is_dir()
    head = git(worktree, "rev-parse", "HEAD").stdout.strip() if exists else ""
    changed = git(worktree, "diff", "--name-only", f"{record['base']}...HEAD").stdout.split() if exists else []
    behind = git(worktree, "rev-list", "--count", "HEAD..origin/main").stdout.strip() if exists else ""
    text = pane(record["session"]) if alive(record["session"]) else ""
    tail = [line for line in text.splitlines() if line.strip()][-12:]
    marker = (cfg["clis"].get(record["cli"]) or {})
    outcome = [m.group(1) for m in OUTCOME_RE.finditer(text)]
    recent = tail[-6:]
    busy_at = max((i for i, l in enumerate(recent) if marker.get("busy") and marker["busy"] in l), default=-1)
    ready_at = max((i for i, l in enumerate(recent) if marker.get("ready") and marker["ready"] in l), default=-1)
    state = "stopped" if not text else ("working" if busy_at > ready_at else "idle")
    return {"project": record["project"], "card": record["card"], "cli": record["cli"], "tier": record["tier"],
            "session": record["session"], "session_alive": bool(text), "state": state,
            "outcome": outcome[-1] if outcome else None, "branch": record["branch"], "base": record["base"][:12],
            "head": head[:12], "behind_main": int(behind) if behind.isdigit() else None,
            "commits": git(worktree, "log", "--oneline", f"{record['base']}..HEAD").stdout.splitlines() if exists else [],
            "changed_files": changed, "outside_scope": outside_scope(record, changed),
            "uncommitted": git(worktree, "status", "--porcelain").stdout.splitlines() if exists else [],
            "review_session": record.get("review_session"), "pane_tail": tail}


def inside(path: str, allowed: str) -> bool:
    prefix = norm(allowed)
    return prefix == "" or path == prefix or path.startswith(prefix + "/")


def outside_scope(record: dict, changed: list[str]) -> list[str]:
    return [f for f in changed if not any(inside(f, allowed) for allowed in record["files"])]


def cmd_status(args: list[str]) -> int:
    pos, _, switch = flags_of(args, {"--fetch"})
    if not pos:
        die(2, "usage: fleet delegate status <project> [card] [--fetch]")
    if len(pos) == 2:
        print(json.dumps(card_status(load_record(*pos), "--fetch" in switch), indent=2))
        return 0
    rows = records(pos[0])
    print(f"{'card':<22}{'cli':<8}{'state':<10}{'branch':<34}{'ahead':>6}{'behind':>8}  outcome")
    for record in rows:
        s = card_status(record, "--fetch" in switch)
        print(f"{s['card']:<22}{s['cli']:<8}{s['state']:<10}{s['branch']:<34}{len(s['commits']):>6}"
              f"{'' if s['behind_main'] is None else s['behind_main']:>8}  {s['outcome'] or ''}")
    print(f"{len(rows)} card(s) in {pos[0]}")
    return 0


def cmd_send(args: list[str]) -> int:
    if len(args) < 3:
        die(2, "usage: fleet delegate send <project> <card> <text...>")
    record = load_record(args[0], args[1])
    if not alive(record["session"]):
        die(2, f"session {record['session']} is not running")
    paste(record["session"], " ".join(args[2:]))
    return 0


def worktree_record() -> dict:
    top = sh(["git", "rev-parse", "--show-toplevel"]).stdout.strip()
    for folder in STATE.glob("*/*.json"):
        record = json.loads(folder.read_text(encoding="utf-8"))
        if Path(record["worktree"]).resolve() == Path(top).resolve():
            return record
    die(2, f"{top or os.getcwd()} is not a worktree of a delegated card")


def cmd_sync_branch(args: list[str]) -> int:
    record = worktree_record()
    worktree = Path(record["worktree"])
    if git(worktree, "status", "--porcelain").stdout.strip():
        die(7, "uncommitted changes: commit (or stash) first, then sync")
    fetched = git(worktree, "fetch", "origin", "--prune")
    if fetched.returncode != 0:
        die(4, f"cannot fetch origin: {fetched.stderr.strip()[:300]}")
    new_base = git(worktree, "rev-parse", "origin/main", check=True).stdout.strip()
    old_base = record["base"]
    rebase = git(worktree, "rebase", "origin/main")
    if rebase.returncode != 0:
        files = git(worktree, "diff", "--name-only", "--diff-filter=U").stdout.split()
        git(worktree, "rebase", "--abort")
        print("conflicts with main in: " + (", ".join(files) or "(see git rebase)"), file=sys.stderr)
        die(6, "the branch is unchanged. Stop and tell the manager; a human (or the card that owns those files) resolves it")
    record["base"] = new_base
    save_record(record)
    print(f"rebased {record['branch']} onto origin/main: base {old_base[:12]} -> {new_base[:12]}")
    pushed = git(worktree, "rev-parse", "--verify", "-q", f"origin/{record['branch']}").returncode == 0
    if pushed:
        print(f"already pushed: git push --force-with-lease origin {record['branch']}")
    if "--verify" in args:
        makefile = worktree / "Makefile"
        if not makefile.exists() or "verify:" not in makefile.read_text(encoding="utf-8"):
            die(10, "no make verify target in this repo: run the verify-create skill first")
        verify = subprocess.run(["make", "verify"], cwd=worktree)
        return verify.returncode
    return 0


def cmd_scope(args: list[str]) -> int:
    if len(args) != 2:
        die(2, "usage: fleet delegate scope <project> <card>")
    record = load_record(*args)
    changed = git(Path(record["worktree"]), "diff", "--name-only", f"{record['base']}...HEAD").stdout.split()
    outside = outside_scope(record, changed)
    print(json.dumps({"allowed": record["files"], "changed": changed, "outside": outside}, indent=2))
    return 8 if outside else 0


def cmd_stop(args: list[str]) -> int:
    if len(args) != 2:
        die(2, "usage: fleet delegate stop <project> <card>")
    record = load_record(*args)
    for session in (record["session"], record.get("review_session")):
        close_session(session)
    record["status"] = "stopped"
    save_record(record)
    print(f"stopped {record['session']} (worktree kept: {record['worktree']})")
    return 0


def cmd_cleanup(args: list[str]) -> int:
    pos, _, switch = flags_of(args, {"--force"})
    if len(pos) != 2:
        die(2, "usage: fleet delegate cleanup <project> <card> [--force]")
    record = load_record(*pos)
    repo = Path(record["repo_path"])
    if "--force" not in switch:
        view = sh(["gh", "pr", "view", record["branch"], "--repo", record["github"], "--json", "state"]) if shutil.which("gh") else None
        state = json.loads(view.stdout).get("state") if view is not None and view.returncode == 0 and view.stdout.strip() else None
        if state != "MERGED":
            die(2, f"the PR of {record['branch']} is {state or 'not found'}, not MERGED: cleanup refuses (use --force to drop unmerged work)")
    for session in (record["session"], record.get("review_session")):
        close_session(session)
    git(repo, "worktree", "remove", "--force", record["worktree"])
    git(repo, "branch", "-D", record["branch"])
    git(repo, "worktree", "prune")
    record_path(*pos).unlink()
    print(f"cleaned {pos[1]}: session, worktree and branch {record['branch']} removed")
    return 0


def cmd_orchestrate(args: list[str]) -> int:
    """Start the project's orchestrator: any CLI agent, in the project directory, with the fleet-manager brief."""
    pos, flag, switch = flags_of(args, {"--dry-run"})
    if len(pos) != 1:
        die(2, "usage: fleet orchestrate <project> [--cli claude|codex|omp] [--tier top|mid|low] [--dry-run]")
    cfg, project = fleet.load(), project_of(pos[0])
    default = {**cfg["orchestrator"], **project["orchestrator"]}
    cli, tier = flag.get("--cli", default["cli"]), flag.get("--tier", default.get("tier", "mid"))
    if cli == "hermes":
        die(2, "this project's orchestrator is Hermes: use its manager profile (hermes -p pm-" + pos[0] + "), not a CLI session")
    if cli not in cfg["clis"]:
        die(2, f"unknown cli {cli!r}")
    session = f"{pos[0]}-orchestrator"
    if alive(session) and "--dry-run" not in switch:
        die(2, f"session {session} already exists")
    repo_lines = "\n".join(f"- {n}: {r['path']} ({r.get('github', r.get('url', ''))})"
                           + (f", hotspots {', '.join(r['hotspots'])}" if r["hotspots"] else "")
                           for n, r in project["repos"].items())
    brief = render("brief-orchestrator.md", plugin=fleet.plugin_name(), start=start_command(fleet.plugin_name(), cli),
                   project=pos[0], dir=project["dir"], repos=repo_lines, fleet=HERE / "fleet", description=project["description"])
    if "--dry-run" not in switch:
        Path(project["dir"]).mkdir(parents=True, exist_ok=True)
    launch(cfg, project["dir"], session, cli, tier, brief, "--dry-run" in switch, "brief-orchestrator.md")
    if "--dry-run" not in switch:
        print(f"orchestrator {cli} ({tier}) for {pos[0]} in {project['dir']}: {attach_hint(session)}")
    return 0


COMMANDS = {"orchestrate": cmd_orchestrate, "start": cmd_start, "review": cmd_review, "status": cmd_status, "send": cmd_send,
            "sync-branch": cmd_sync_branch, "scope": cmd_scope, "stop": cmd_stop, "cleanup": cmd_cleanup}


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help") or args[0] not in COMMANDS:
        print(__doc__)
        return 0 if not args or args[0] in ("-h", "--help") else 2
    for tool in ("git", "orca-ide" if launcher_name() == "orca" else "tmux"):
        if not shutil.which(tool):
            die(2, f"{tool} is not installed")
    return COMMANDS[args[0]](args[1:])


if __name__ == "__main__":
    sys.exit(main())
