#!/usr/bin/env python3
"""fleet: run the plugin's agents on Hermes Kanban. Agents and models come from fleet/models.yaml,
projects from fleet/projects.yaml.

    fleet models show                     every agent, its level and its model
    fleet models check                    models exist where they run, providers are logged in, projects are sound
    fleet models apply [--dry-run]        push the models to every Hermes profile and to omp
    fleet models cmd <lane> <tier>        the CLI argv a lane runs for a card, one argument per line
    fleet models reviewer <lane>          "<lane> <tier>" that reviews work written in <lane>
    fleet models subagent <name>          the Claude Code model for a plugin subagent (used by the build)
    fleet project add <name> --repo <path> --github <owner/repo> [--description "..."] [--dry-run]
    fleet project list
    fleet project sync <name> [--dry-run] manager profile, board and Hermes project for one project
    fleet bootstrap [--dry-run]           every profile (root, managers, lanes), tools, skills, board settings
    fleet sync [--dry-run]                Hermes: share the root login and API keys with every profile, apply models,
                                          context limits and skills; also the Hermes slash command /sync
    fleet context show                    context window and compaction point per tool and per Hermes profile
    fleet context apply [--dry-run]       write them into Claude Code, Codex and oh-my-pi
    fleet context env <lane> <tier>       KEY=value lines a lane exports before it runs its CLI
    fleet lane run|review ...             run one card through a lane (see fleet-lane)
    fleet merge <pr> --risk R --sha S [--repo owner/repo] [--approved] [--dry-run]
                                          the merge gate, then gh pr merge --squash --auto
    fleet name                            the plugin name ($PLUGIN_NAME, else plugin.env, default swe)

Environment: FLEET_MODELS, FLEET_PROJECTS, OMP_CONFIG, CLAUDE_SETTINGS, CODEX_CONFIG (file paths), HERMES_HOME.
"""

from __future__ import annotations

import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

import yaml

FLEET = Path(__file__).resolve().parents[1]
REPO = FLEET.parent
MODELS = Path(os.environ.get("FLEET_MODELS", FLEET / "models.yaml"))
PROJECTS = Path(os.environ.get("FLEET_PROJECTS", FLEET / "projects.yaml"))
OMP_CONFIG = Path(os.environ.get("OMP_CONFIG", Path.home() / ".omp/agent/config.yml"))
CLAUDE_SETTINGS = Path(os.environ.get("CLAUDE_SETTINGS", Path.home() / ".claude/settings.json"))
CODEX_CONFIG = Path(os.environ.get("CODEX_CONFIG", Path.home() / ".codex/config.toml"))
CLAUDE_ALIASES = {"opus", "sonnet", "haiku", "fable"}
TIERS = ("top", "mid", "low")
LEVELS = ("board", "lanes", "workers", "reviewers", "subagents", "omp_roles", "context", "kanban", "autopilot")
NEVER_AUTO_MERGE = {"money-path"}
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
GITHUB_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
# Root .env variables a profile receives on sync: provider API keys and base URLs, never messaging
# credentials (each bot token belongs to one gateway; Hermes strips the same set when it clones).
SHARED_ENV_SUFFIXES = ("_API_KEY", "_API_KEYS", "_BASE_URL")
CHANNEL_PREFIXES = ("TELEGRAM_", "DISCORD_", "SLACK_", "WHATSAPP_", "MATRIX_", "MATTERMOST_", "SIGNAL_", "WECOM_",
                    "FEISHU_", "DINGTALK_", "LINE_", "BLUEBUBBLES_", "SMS_", "TWILIO_", "EMAIL_", "HASS_", "QQ_",
                    "GATEWAY_", "API_SERVER_", "WEBHOOK_")


# ------------------------------------------------------------------------------------------------ config


def load() -> dict:
    cfg = yaml.safe_load(MODELS.read_text(encoding="utf-8")) or {}
    missing = [level for level in LEVELS if level not in cfg]
    if missing:
        sys.exit(f"fleet: {MODELS} is missing: {', '.join(missing)}")
    return cfg


def load_projects() -> dict[str, dict]:
    if not PROJECTS.exists():
        return {}
    return (yaml.safe_load(PROJECTS.read_text(encoding="utf-8")) or {}).get("projects") or {}


def save_projects(projects: dict[str, dict]) -> None:
    header = []
    if PROJECTS.exists():
        for line in PROJECTS.read_text(encoding="utf-8").splitlines():
            if line.startswith("projects:"):
                break
            header.append(line)
    body = yaml.safe_dump({"projects": dict(sorted(projects.items()))}, sort_keys=False, allow_unicode=True)
    PROJECTS.write_text("\n".join(header) + ("\n" if header else "") + body, encoding="utf-8")


def plugin_name() -> str:
    if os.environ.get("PLUGIN_NAME"):
        return os.environ["PLUGIN_NAME"]
    for env_file in (REPO / "plugin.local.env", REPO / "plugin.env"):
        if env_file.exists():
            for line in env_file.read_text(encoding="utf-8").splitlines():
                match = re.match(r"^\s*PLUGIN_NAME\s*\??=\s*(\S+)", line)
                if match:
                    return match.group(1)
    return "swe"


def manager_profile(project: str) -> str:
    return f"pm-{project}"


def worker(cfg: dict, lane: str, tier: str) -> dict:
    try:
        return cfg["workers"][lane][tier]
    except KeyError:
        sys.exit(f"fleet: no worker for lane {lane!r} tier {tier!r} in {MODELS}")


def argv(cfg: dict, lane: str, tier: str) -> list[str]:
    spec = worker(cfg, lane, tier)
    cli = cfg["lanes"][lane]["cli"]
    if cli == "claude":
        args = ["claude", "-p", "--model", spec["model"]]
        if spec.get("effort"):
            args += ["--effort", spec["effort"]]
        return args + ["--permission-mode", "bypassPermissions"]
    if cli == "omp":
        args = ["omp", "-p", "--model", spec["model"]]
        if spec.get("thinking"):
            args += ["--thinking", spec["thinking"]]
        return args + ["--approval-mode", "yolo", "--max-time", "45m"]
    sys.exit(f"fleet: lane {lane!r} has unknown cli {cli!r}")


def profiles(cfg: dict, projects: dict[str, dict]) -> dict[str, dict]:
    """Every Hermes profile: name -> spec with level, role, brain, tools, skills, description."""
    result: dict[str, dict] = {}
    root = cfg["board"]["root"]
    result[root["profile"]] = {**root, "level": "board", "role": "root"}
    template = cfg["board"]["manager"]
    for name, project in projects.items():
        description = template["description"].format(project=name, description=project.get("description", ""))
        result[manager_profile(name)] = {**template, "description": description, "level": "board",
                                         "role": "manager", "project": name}
    for lane, spec in cfg["lanes"].items():
        result[lane] = {**spec, "level": "lanes", "role": "lane"}
    return result


# ------------------------------------------------------------------------------------------------ hermes


def run(args: list[str], timeout: int = 180) -> subprocess.CompletedProcess:
    return subprocess.run(args, capture_output=True, text=True, timeout=timeout)


def hermes(profile: str, *args: str) -> list[str]:
    return (["hermes"] if profile == "default" else ["hermes", "-p", profile]) + list(args)


def hermes_profiles() -> set[str]:
    names = set()
    for line in run(["hermes", "profile", "list"]).stdout.splitlines():
        first = line.strip().lstrip("◆").split()
        if first:
            names.add(first[0])
    return names


def execute(commands: list[list[str]], dry: bool) -> int:
    for command in commands:
        print(("would run: " if dry else "run: ") + " ".join(command))
        if dry:
            continue
        result = run(command)
        if result.returncode != 0:
            print(result.stdout + result.stderr, file=sys.stderr)
            return 1
    return 0


def listed(output: str, name: str) -> bool:
    return re.search(rf"(^|\s){re.escape(name)}(\s|$)", output, re.M) is not None


# ------------------------------------------------------------------------------------------------ models


def subagent_model(cfg: dict, name: str) -> str:
    spec = cfg["subagents"].get(name)
    if not spec:
        return "inherit"
    return worker(cfg, "claude", spec["tier"])["model"]


def models_show(cfg: dict, projects: dict[str, dict]) -> int:
    rows = []
    for name, spec in profiles(cfg, projects).items():
        if spec["level"] == "board":
            agent = "root" if spec["role"] == "root" else f"manager {spec['project']}"
            rows.append(("board", agent, name, spec["brain"]["model"], spec["brain"]["provider"]))
    if not projects:
        template = cfg["board"]["manager"]["brain"]
        rows.append(("board", "manager (template)", "pm-<project>", template["model"], template["provider"]))
    for lane, spec in cfg["lanes"].items():
        rows.append(("lane", lane, lane, spec["brain"]["model"], f"{spec['brain']['provider']} (drives {spec['cli']})"))
    for lane, tiers in cfg["workers"].items():
        for tier in TIERS:
            spec = tiers[tier]
            rows.append(("worker", f"{lane} {tier}", lane, spec["model"], spec.get("effort") or spec.get("thinking") or ""))
    for author, spec in cfg["reviewers"].items():
        rows.append(("reviewer", f"of {author}", spec["lane"], worker(cfg, spec["lane"], spec["tier"])["model"], spec["tier"]))
    for name, spec in cfg["subagents"].items():
        rows.append(("subagent", f"{plugin_name()}:{name}", "claude code", subagent_model(cfg, name), spec["tier"]))
    for role, model in cfg["omp_roles"].items():
        rows.append(("omp role", role, "omp", model, ""))
    print(f"{'level':<10}{'agent':<24}{'runs as':<16}{'model':<40}extra")
    for row in rows:
        print(f"{row[0]:<10}{row[1]:<24}{row[2]:<16}{row[3]:<40}{row[4]}")
    print(f"projects: {', '.join(sorted(projects)) or 'none (fleet project add)'}")
    print(f"autopilot auto_merge: {cfg['autopilot'].get('auto_merge') or 'off'}")
    return 0


def omp_models() -> set[str]:
    out = run(["omp", "models", "ls", "--json"]).stdout if shutil.which("omp") else ""
    data = json.loads(out or "[]")
    items = data if isinstance(data, list) else data.get("models", [])
    return {f"{m.get('provider')}/{m.get('id')}" for m in items if isinstance(m, dict)}


def project_problems(name: str, project: dict) -> list[str]:
    problems = []
    if not NAME_RE.match(name):
        problems.append(f"project {name!r}: name must match {NAME_RE.pattern}")
    repo = Path(os.path.expanduser(project.get("repo", "")))
    if not (repo / ".git").exists():
        problems.append(f"project {name}: repo {repo} is not a git clone")
    if not GITHUB_RE.match(project.get("github", "")):
        problems.append(f"project {name}: github must be owner/repo, got {project.get('github')!r}")
    return problems


def models_check(cfg: dict, projects: dict[str, dict]) -> int:
    problems = []
    for author, spec in cfg["reviewers"].items():
        if spec["lane"] == author and len(cfg["lanes"]) > 1:
            problems.append(f"reviewers.{author} must be the other lane, not {author} (two lanes are configured)")
        worker(cfg, spec["lane"], spec["tier"])
    for lane, spec in cfg["lanes"].items():
        if lane not in cfg["workers"]:
            problems.append(f"lane {lane} has no workers")
        if spec["cli"] == "claude":
            for tier, w in cfg["workers"][lane].items():
                if w["model"] not in CLAUDE_ALIASES and not w["model"].startswith("claude-"):
                    problems.append(f"workers.{lane}.{tier}: {w['model']!r} is not a Claude model")
    for name, spec in cfg["subagents"].items():
        if spec["tier"] not in TIERS:
            problems.append(f"subagents.{name}: tier must be one of {', '.join(TIERS)}")
    if NEVER_AUTO_MERGE & set(cfg["autopilot"].get("auto_merge") or []):
        problems.append("autopilot.auto_merge must never include money-path")
    for name, project in projects.items():
        problems += project_problems(name, project)
    available = omp_models()
    omp_lanes = [lane for lane, spec in cfg["lanes"].items() if spec["cli"] == "omp"]
    used = [w["model"] for lane in omp_lanes for w in cfg["workers"][lane].values()] + list(cfg["omp_roles"].values())
    for model in sorted(set(used)):
        if model not in available:
            problems.append(f"omp has no model {model} (log in: omp login <provider>; list: omp models ls)")
    existing = hermes_profiles()
    for profile in profiles(cfg, projects):
        if profile != "default" and profile not in existing:
            problems.append(f"hermes profile {profile} does not exist (run: fleet bootstrap)")
    for provider in sorted({spec["brain"]["provider"] for spec in profiles(cfg, projects).values()}):
        result = run(["hermes", "auth", "status", provider])
        status = result.stdout + result.stderr
        if "logged in" not in status or "logged out" in status:
            problems.append(f"hermes provider {provider} is logged out (hermes auth add {provider})")
    if shutil.which("gh") and run(["gh", "auth", "status"]).returncode != 0:
        problems.append("gh is not logged in (gh auth login): agents cannot push, open PRs or manage issues")
    problems += context_problems(cfg)
    for message in problems:
        print("PROBLEM", message)
    print(f"{len(problems)} problem(s)")
    return 1 if problems else 0


def backup_and_write(path: Path, text: str) -> None:
    if path.exists():
        shutil.copy2(path, path.with_name(f"{path.name}.bak-{int(time.time())}"))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def models_apply(cfg: dict, projects: dict[str, dict], dry: bool) -> int:
    """Hermes profiles (through sync) and omp's model roles."""
    if sync(cfg, projects, dry):
        return 1
    data = (yaml.safe_load(OMP_CONFIG.read_text(encoding="utf-8")) if OMP_CONFIG.exists() else None) or {}
    data.setdefault("setupVersion", 2)
    wanted = {**(data.get("modelRoles") or {}), **cfg["omp_roles"]}
    if data.get("modelRoles") == wanted:
        print(f"omp model roles unchanged in {OMP_CONFIG}")
    else:
        data["modelRoles"] = wanted
        print(("would write: " if dry else "write: ") + f"{OMP_CONFIG} modelRoles = {cfg['omp_roles']}")
        if not dry:
            backup_and_write(OMP_CONFIG, yaml.safe_dump(data, sort_keys=False))
    print("workers and reviewers need no apply: fleet lane reads models.yaml on every card run")
    print("plugin subagents: rebuild and reinstall the plugin (make claude)")
    return 0


# ------------------------------------------------------------------------------------------------ context


def is_claude(model: str) -> bool:
    bare = model.lower().split("/")[-1]
    return bare in CLAUDE_ALIASES or bare.startswith("claude")


def context_for(cfg: dict, model: str) -> tuple[int, int]:
    """(window, compact_at) in tokens for a model: an exact override, else its family, else the default."""
    ctx = cfg["context"]
    overrides = ctx.get("models") or {}
    spec = overrides.get(model) or overrides.get(model.split("/")[-1])
    if spec is None and is_claude(model):
        spec = (ctx.get("families") or {}).get("claude")
    spec = spec or ctx["default"]
    return int(spec["window"]), int(spec["compact_at"])


def context_problems(cfg: dict) -> list[str]:
    ctx = cfg["context"]
    specs = {"default": ctx.get("default")}
    specs.update({f"families.{k}": v for k, v in (ctx.get("families") or {}).items()})
    specs.update({f"models.{k}": v for k, v in (ctx.get("models") or {}).items()})
    problems = []
    for name, spec in specs.items():
        try:
            window, compact = int(spec["window"]), int(spec["compact_at"])
        except (KeyError, TypeError, ValueError):
            problems.append(f"context.{name}: needs integer window and compact_at")
            continue
        if not 0 < compact < window:
            problems.append(f"context.{name}: compact_at {compact} must be above 0 and below window {window}")
    return problems


def hermes_threshold(window: int, compact: int) -> float:
    """compression.threshold that lets compression.threshold_tokens decide: Hermes floors the ratio
    at 0.75 for windows under 512K, so a higher ratio is needed to compact later than that."""
    return math.ceil(compact / window * 100) / 100


def top_level_toml(path: Path) -> dict:
    import tomllib
    return tomllib.loads(path.read_text(encoding="utf-8")) if path.exists() else {}


def set_toml_top_level(text: str, values: dict[str, int]) -> str:
    """Set top-level keys (before the first [table]), leaving every table and comment as it is."""
    lines = text.splitlines()
    first_table = next((i for i, line in enumerate(lines) if line.lstrip().startswith("[")), len(lines))
    for key, value in values.items():
        pattern = re.compile(rf"^\s*{re.escape(key)}\s*=")
        index = next((i for i in range(first_table) if pattern.match(lines[i])), None)
        if index is None:
            lines.insert(first_table, f"{key} = {value}")
            first_table += 1
        else:
            lines[index] = f"{key} = {value}"
    return "\n".join(lines) + "\n"


def context_apply(cfg: dict, dry: bool) -> int:
    """Write the policy into the user-level config of Claude Code, Codex and oh-my-pi."""
    prefix = "would write" if dry else "write"
    # Claude Code: autoCompactWindow is the size at which it compacts (300-400k for Claude models)
    _, claude_compact = context_for(cfg, "claude")
    settings = json.loads(CLAUDE_SETTINGS.read_text(encoding="utf-8")) if CLAUDE_SETTINGS.exists() else {}
    if settings.get("autoCompactWindow") == claude_compact:
        print(f"claude code: autoCompactWindow {claude_compact} unchanged in {CLAUDE_SETTINGS}")
    else:
        print(f"{prefix}: {CLAUDE_SETTINGS} autoCompactWindow = {claude_compact}")
        settings["autoCompactWindow"] = claude_compact
        if not dry:
            backup_and_write(CLAUDE_SETTINGS, json.dumps(settings, indent=2, ensure_ascii=False) + "\n")
    # Codex and every other model: the default policy
    window, compact = int(cfg["context"]["default"]["window"]), int(cfg["context"]["default"]["compact_at"])
    current = top_level_toml(CODEX_CONFIG)
    wanted = {"model_context_window": window, "model_auto_compact_token_limit": compact}
    if all(current.get(k) == v for k, v in wanted.items()):
        print(f"codex: {window} / {compact} unchanged in {CODEX_CONFIG}")
    else:
        print(f"{prefix}: {CODEX_CONFIG} model_context_window = {window}, model_auto_compact_token_limit = {compact}")
        if not dry:
            text = CODEX_CONFIG.read_text(encoding="utf-8") if CODEX_CONFIG.exists() else ""
            backup_and_write(CODEX_CONFIG, set_toml_top_level(text, wanted))
    # oh-my-pi: one global threshold, the default policy (omp has no per-model override)
    data = (yaml.safe_load(OMP_CONFIG.read_text(encoding="utf-8")) if OMP_CONFIG.exists() else None) or {}
    if (data.get("compaction") or {}).get("thresholdTokens") == compact:
        print(f"omp: compaction.thresholdTokens {compact} unchanged in {OMP_CONFIG}")
    else:
        print(f"{prefix}: {OMP_CONFIG} compaction.thresholdTokens = {compact}")
        data.setdefault("setupVersion", 2)
        data.setdefault("compaction", {})["thresholdTokens"] = compact
        if not dry:
            backup_and_write(OMP_CONFIG, yaml.safe_dump(data, sort_keys=False))
    print("Hermes profiles: fleet sync")
    return 0


def context_show(cfg: dict, projects: dict[str, dict]) -> int:
    window, compact = int(cfg["context"]["default"]["window"]), int(cfg["context"]["default"]["compact_at"])
    _, claude_compact = context_for(cfg, "claude")
    claude_window = context_for(cfg, "claude")[0]
    rows = [("Claude Code", "autoCompactWindow", "claude", claude_window, claude_compact),
            ("Codex", "model_context_window", "default", window, compact),
            ("oh-my-pi", "compaction.thresholdTokens", "default", window, compact)]
    for name, spec in profiles(cfg, projects).items():
        w, c = context_for(cfg, spec["brain"]["model"])
        rows.append((f"Hermes {name}", f"{spec['brain']['model']}", "claude" if is_claude(spec["brain"]["model"]) else "default", w, c))
    print(f"{'agent':<24}{'model / key':<34}{'policy':<9}{'window':>9}{'compacts at':>13}")
    for agent, key, policy, w, c in rows:
        print(f"{agent:<24}{key:<34}{policy:<9}{w:>9,}{c:>13,}")
    return 0


def context_env(cfg: dict, lane: str, tier: str) -> int:
    """Environment a lane exports before its CLI starts (Claude Code reads its compaction point from it)."""
    if cfg["lanes"][lane]["cli"] == "claude":
        print(f"CLAUDE_CODE_AUTO_COMPACT_WINDOW={context_for(cfg, worker(cfg, lane, tier)['model'])[1]}")
    return 0


# ------------------------------------------------------------------------------------------------ sync


def hermes_root() -> Path:
    home = Path(os.environ.get("HERMES_HOME", Path.home() / ".hermes"))
    return home.parent.parent if home.parent.name == "profiles" else home


def profile_dir(name: str) -> Path:
    return hermes_root() if name == "default" else hermes_root() / "profiles" / name


def nested(data: dict, dotted: str):
    for part in dotted.split("."):
        if not isinstance(data, dict) or part not in data:
            return None
        data = data[part]
    return data


def same_value(current, wanted) -> bool:
    if isinstance(wanted, list):
        return isinstance(current, list) and [str(x) for x in current] == [str(x) for x in wanted]
    try:
        return float(current) == float(wanted)
    except (TypeError, ValueError):
        return str(current) == str(wanted)


def env_values(path: Path) -> dict[str, str]:
    values = {}
    if path.exists():
        for line in path.read_text(encoding="utf-8").splitlines():
            match = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$", line)
            if match:
                values[match.group(1)] = match.group(2)
    return values


def shared_env_keys(names) -> list[str]:
    return sorted(n for n in names if n.endswith(SHARED_ENV_SUFFIXES) and not n.startswith(CHANNEL_PREFIXES))


def sync_env(profile: str, dry: bool) -> list[str]:
    """Copy provider keys from the root .env into a profile's .env; returns the names added or updated."""
    source = env_values(hermes_root() / ".env")
    target_path = profile_dir(profile) / ".env"
    target = env_values(target_path)
    changed = [k for k in shared_env_keys(source) if target.get(k) != source[k]]
    if changed and not dry:
        lines = target_path.read_text(encoding="utf-8").splitlines() if target_path.exists() else []
        for key in changed:
            pattern = re.compile(rf"^\s*(?:export\s+)?{re.escape(key)}\s*=")
            index = next((i for i, line in enumerate(lines) if pattern.match(line)), None)
            if index is None:
                lines.append(f"{key}={source[key]}")
            else:
                lines[index] = f"{key}={source[key]}"
        target_path.parent.mkdir(parents=True, exist_ok=True)
        target_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
        target_path.chmod(0o600)
    return changed


def desired_settings(cfg: dict, name: str, spec: dict) -> dict[str, object]:
    model = spec["brain"]["model"]
    window, compact = context_for(cfg, model)
    wanted: dict[str, object] = {
        "model.default": model,
        "model.provider": spec["brain"]["provider"],
        "model.context_length": window,
        "compression.threshold": hermes_threshold(window, compact),
        "compression.threshold_tokens": compact,
        "skills.external_dirs": skill_dirs(),
    }
    if name == "default":
        wanted["quick_commands.sync.type"] = "exec"
        wanted["quick_commands.sync.command"] = f"{sys.executable} {FLEET / 'bin' / 'fleet'} sync"
    return wanted


def sync(cfg: dict, projects: dict[str, dict], dry: bool) -> int:
    """Make every Hermes profile follow the root: login, API keys, models, context limits, skills.

    Logins need no copy: Hermes reads the root auth.json as a per-provider fallback in every
    profile (and copying an OAuth token would break it, since refresh tokens are single use).
    Fast on purpose (it is the /sync slash command, which Hermes cuts off after 30 s): it reads
    each profile's config.yaml and runs `hermes config set` only for what differs."""
    started = time.time()
    specs = profiles(cfg, projects)
    present = {"default"} | ({d.name for d in (hermes_root() / "profiles").iterdir() if d.is_dir()}
                             if (hermes_root() / "profiles").is_dir() else set())
    failures, lines = 0, []
    missing = [n for n in specs if n not in present and not dry]
    # logins: report what the root has and which profiles shadow it with their own entries
    providers = sorted({spec["brain"]["provider"] for spec in specs.values()})
    out, shadows = [], []
    for provider in providers:
        status = run(["hermes", "auth", "status", provider]) if not dry else None
        text = (status.stdout + status.stderr) if status else ""
        out.append(f"{provider} {'logged in' if status and 'logged in' in text and 'logged out' not in text else 'not logged in on default' if status else '(dry run)'}")
    for name in specs:
        auth_file = profile_dir(name) / "auth.json"
        if name != "default" and auth_file.exists():
            try:
                store = json.loads(auth_file.read_text(encoding="utf-8"))
            except ValueError:
                continue
            own = sorted((set((store.get("providers") or {})) | set((store.get("credential_pool") or {}))) & set(providers))
            if own:
                shadows.append(f"{name} has its own {', '.join(own)} login (it hides the one on default)")
    lines.append("login: " + "; ".join(out) + ("  [log in with: hermes auth add <provider>, on the default profile]" if any("not logged" in o for o in out) else ""))
    lines += [f"warning: {s}" for s in shadows]
    for name, spec in specs.items():
        if name in missing:
            lines.append(f"{name}: missing, run: fleet bootstrap")
            continue
        notes = []
        if name != "default":
            keys = sync_env(name, dry)
            if keys:
                notes.append("env " + ", ".join(f"+{k}" for k in keys))
        config_file = profile_dir(name) / "config.yaml"
        current = (yaml.safe_load(config_file.read_text(encoding="utf-8")) or {}) if config_file.exists() else {}
        changed = []
        for key, value in desired_settings(cfg, name, spec).items():
            if same_value(nested(current, key), value):
                continue
            rendered = json.dumps(value) if isinstance(value, list) else str(value)
            command = hermes(name, "config", "set", key, rendered)
            if dry:
                print("would run: " + " ".join(command))
                changed.append(key)
                continue
            result = run(command)
            if result.returncode != 0:
                failures += 1
                lines.append(f"{name}: FAILED {key}: {(result.stdout + result.stderr).strip().splitlines()[-1:]}")
            else:
                changed.append(key)
        if changed:
            notes.append(f"{len(changed)} setting(s): " + ", ".join(changed))
        lines.append(f"{name}: " + ("; ".join(notes) if notes else "already in sync"))
    lines.append(f"{'dry run' if dry else 'done'} in {time.time() - started:.1f}s")
    print("\n".join(lines))
    return 1 if failures else 0


# ------------------------------------------------------------------------------------------------ bootstrap


def skill_dirs() -> list[str]:
    name = plugin_name()
    return [str((REPO / "dist" / name / "fleet" / "skills").resolve()), str((REPO / "dist" / name / "skills").resolve())]


def profile_commands(name: str, spec: dict, existing: set[str]) -> list[list[str]]:
    commands = []
    if name != "default" and name not in existing:
        commands.append(["hermes", "profile", "create", name, "--no-alias", "--description", spec["description"]])
    elif name != "default":
        commands.append(["hermes", "profile", "describe", name, "--text", spec["description"]])
    commands.append(hermes(name, "config", "set", "skills.external_dirs", json.dumps(skill_dirs())))
    tools = spec.get("tools") or {}
    if tools.get("enable"):
        commands.append(hermes(name, "tools", "enable", *tools["enable"]))
    if tools.get("disable"):
        commands.append(hermes(name, "tools", "disable", *tools["disable"]))
    return commands


def build_plugin() -> int:
    build = run([sys.executable, str(REPO / "scripts" / "build.py")], timeout=300)
    if build.returncode != 0:
        print(build.stdout + build.stderr, file=sys.stderr)
    return build.returncode


def project_sync(cfg: dict, projects: dict[str, dict], name: str, dry: bool) -> int:
    if name not in projects:
        sys.exit(f"fleet: no project {name!r} in {PROJECTS}")
    project = projects[name]
    problems = project_problems(name, project)
    if problems:
        print("\n".join("PROBLEM " + p for p in problems))
        return 1
    manager = manager_profile(name)
    spec = profiles(cfg, projects)[manager]
    repo = str(Path(os.path.expanduser(project["repo"])).resolve())
    existing = set() if dry else hermes_profiles()
    commands = profile_commands(manager, spec, existing)
    commands.append(hermes(manager, "config", "set", "model.default", spec["brain"]["model"]))
    commands.append(hermes(manager, "config", "set", "model.provider", spec["brain"]["provider"]))
    if execute(commands, dry):
        return 1
    boards = "" if dry else run(["hermes", "kanban", "boards", "list"]).stdout
    if listed(boards, name):
        print(f"board {name} exists")
    elif execute([["hermes", "kanban", "boards", "create", name, "--default-workdir", repo,
                   "--description", project.get("description", "")]], dry):
        return 1
    for profile in ("default", manager):
        known = "" if dry else run(hermes(profile, "project", "list")).stdout
        if listed(known, name):
            print(f"project {name} exists for {profile}")
            continue
        if execute([hermes(profile, "project", "create", name, repo, "--slug", name, "--board", name)], dry):
            return 1
    print(f"project {name}: manager {manager}, board {name}, repo {repo}, github {project['github']}")
    return 0


def project_add(cfg: dict, args: list[str], dry: bool) -> int:
    usage = "usage: fleet project add <name> --repo <path> --github <owner/repo> [--description \"...\"]"
    if not args:
        sys.exit(usage)
    name, flags = args[0], dict(zip(args[1::2], args[2::2]))
    if "--repo" not in flags or "--github" not in flags:
        sys.exit(usage)
    projects = load_projects()
    entry = {"repo": flags["--repo"], "github": flags["--github"], "description": flags.get("--description", name)}
    problems = project_problems(name, entry)
    if problems:
        print("\n".join("PROBLEM " + p for p in problems))
        return 1
    projects[name] = entry
    if dry:
        print(f"would add project {name} to {PROJECTS}: {entry}")
    else:
        save_projects(projects)
        print(f"added project {name} to {PROJECTS}")
        if build_plugin():
            return 1
    return project_sync(cfg, projects, name, dry)


def bootstrap(cfg: dict, projects: dict[str, dict], dry: bool) -> int:
    if not dry and build_plugin():
        return 1
    existing = set() if dry else hermes_profiles()
    commands: list[list[str]] = []
    for name, spec in profiles(cfg, projects).items():
        if spec.get("role") != "manager":
            commands += profile_commands(name, spec, existing)
    for key, value in cfg["kanban"].items():
        rendered = str(value).lower() if isinstance(value, bool) else str(value)
        commands.append(["hermes", "config", "set", f"kanban.{key}", rendered])
    if execute(commands, dry):
        return 1
    for name in sorted(projects):
        if project_sync(cfg, projects, name, dry):
            return 1
    return models_apply(cfg, projects, dry) or context_apply(cfg, dry)


# ------------------------------------------------------------------------------------------------ merge


def merge(cfg: dict, pr: str, risk: str, sha: str, repo: str, approved: bool, dry: bool) -> int:
    """The merge gate: an allowed risk class (or the human's approval), the verified SHA, green checks."""
    allowed = set(cfg["autopilot"].get("auto_merge") or []) - NEVER_AUTO_MERGE
    target = ["--repo", repo] if repo else []

    def refuse(reason: str) -> int:
        print(f"REFUSED {pr}: {reason}")
        return 3

    if not approved:
        if risk in NEVER_AUTO_MERGE:
            return refuse("money-path is never auto-merged: it needs the human's approval (--approved)")
        if risk not in allowed:
            return refuse(f"risk {risk!r} is not in autopilot.auto_merge {sorted(allowed) or '(off)'}: wait for the human")
    view = run(["gh", "pr", "view", pr, *target, "--json", "headRefOid,state,isDraft"])
    if view.returncode != 0:
        return refuse(f"gh pr view failed: {view.stderr.strip()}")
    info = json.loads(view.stdout)
    if info.get("state") != "OPEN" or info.get("isDraft"):
        return refuse(f"PR is {info.get('state')}{' (draft)' if info.get('isDraft') else ''}")
    if info.get("headRefOid") != sha:
        return refuse(f"head {info.get('headRefOid')} is not the verified SHA {sha}: a new push needs a new review")
    checks = run(["gh", "pr", "checks", pr, *target, "--required", "--json", "name,bucket"])
    if checks.returncode != 0 and not checks.stdout.strip():
        return refuse(f"gh pr checks failed: {checks.stderr.strip()}")
    required = json.loads(checks.stdout or "[]")
    if not required:
        return refuse("no required checks on this PR: make `make verify` a required check first (project skill)")
    red = [f"{c['name']} ({c.get('bucket')})" for c in required if c.get("bucket") != "pass"]
    if red:
        return refuse("required checks not green: " + ", ".join(red))
    print(f"gate passed for {pr} at {sha} ({'approved by the human' if approved else 'autopilot: ' + risk})")
    merge_command = ["gh", "pr", "merge", pr, *target, "--squash", "--auto", "--delete-branch", "--match-head-commit", sha]
    return execute([merge_command], dry)


# ------------------------------------------------------------------------------------------------ main


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    command, rest = args[0], args[1:]
    if command == "name":
        print(plugin_name())
        return 0
    if command == "lane":
        os.execv(str(FLEET / "bin" / "fleet-lane"), [str(FLEET / "bin" / "fleet-lane"), *rest])
    cfg = load()
    projects = load_projects()
    dry = "--dry-run" in rest
    approved = "--approved" in rest
    rest = [a for a in rest if a not in ("--dry-run", "--approved")]
    if command == "models":
        action = rest[0] if rest else "show"
        if action == "show":
            return models_show(cfg, projects)
        if action == "check":
            return models_check(cfg, projects)
        if action == "apply":
            return models_apply(cfg, projects, dry)
        if action == "cmd" and len(rest) == 3:
            print("\n".join(argv(cfg, rest[1], rest[2])))
            return 0
        if action == "reviewer" and len(rest) == 2:
            spec = cfg["reviewers"][rest[1]]
            print(spec["lane"], spec["tier"])
            return 0
        if action == "subagent" and len(rest) == 2:
            print(subagent_model(cfg, rest[1]))
            return 0
    if command == "project" and rest:
        if rest[0] == "add":
            return project_add(cfg, rest[1:], dry)
        if rest[0] == "list":
            for name, project in sorted(projects.items()):
                print(f"{name:<20}{manager_profile(name):<24}{project.get('github', ''):<36}{project.get('repo', '')}")
            return 0
        if rest[0] == "sync" and len(rest) == 2:
            return project_sync(cfg, projects, rest[1], dry)
    if command == "bootstrap":
        return bootstrap(cfg, projects, dry)
    if command == "sync":
        return sync(cfg, projects, dry)
    if command == "context" and rest:
        if rest[0] == "show":
            return context_show(cfg, projects)
        if rest[0] == "apply":
            return context_apply(cfg, dry)
        if rest[0] == "env" and len(rest) == 3:
            return context_env(cfg, rest[1], rest[2])
    if command == "merge" and rest:
        flags = dict(zip(rest[1::2], rest[2::2]))
        if "--risk" not in flags or "--sha" not in flags:
            sys.exit("usage: fleet merge <pr> --risk <low|standard|money-path> --sha <verified sha> "
                     "[--repo owner/repo] [--approved] [--dry-run]")
        return merge(cfg, rest[0], flags["--risk"], flags["--sha"], flags.get("--repo", ""), approved, dry)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
