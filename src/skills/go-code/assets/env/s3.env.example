# S3-compatible object store (RustFS, MinIO, AWS S3): every variable is read from the environment by config.LoadS3.
# Endpoint URL of the store; path-style addressing (http://host:9000/<bucket>/<key>) is the default for RustFS/MinIO.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=example-local
S3_FORCE_PATH_STYLE=true
# SECRETS: required, NO default, never committed (S3_ACCESS_KEY_FILE / S3_SECRET_KEY_FILE in Swarm).
S3_ACCESS_KEY=
S3_SECRET_KEY=
