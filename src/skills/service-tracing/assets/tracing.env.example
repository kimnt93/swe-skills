# Tracing: the same variable names in every language (see references/env.md).
# Standard OpenTelemetry variables are used wherever one exists; TRACING_DETAIL and PEER_SERVICE_* are this skill's.
# An empty OTEL_EXPORTER_OTLP_ENDPOINT (or OTEL_TRACES_EXPORTER=none / OTEL_SDK_DISABLED=true) disables export;
# the service must keep working without a collector.

# ---- identity: one stable logical name per deployable service (also used by logs and metrics) ----
# Required. Same value as the compose service / SERVICE_NAME of the logging and metrics skills.
OTEL_SERVICE_NAME=example-api
SERVICE_NAME=example-api
# deployment.environment (and deployment.environment.name): DEPLOYMENT_ENVIRONMENT, else RUN_ENV, else ENV_NAME.
RUN_ENV=local
# host.name: the Docker/Kubernetes HOST (Swarm: NODE_NAME: "{{.Node.Hostname}}"); unset = the hostname.
# NODE_NAME=
# service.version: an immutable revision or release (CI sets it); extra resource attributes as k=v,k=v.
SERVICE_VERSION=
# OTEL_RESOURCE_ATTRIBUTES=team=platform

# ---- export (OTLP over HTTP; the client appends /v1/traces to the base URL) ----
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-gateway:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=5000
# A trace-only endpoint overrides the base; it is used as given in the SDK, the templates strip a trailing /v1/traces.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Bearer token for the gateway: a SECRET. Never set a default and never commit a value.
# Swarm/Kubernetes: mount a secret and set OTEL_AUTH_TOKEN_FILE (path), not OTEL_AUTH_TOKEN.
OTEL_AUTH_TOKEN=
# OTEL_AUTH_TOKEN_FILE=/run/secrets/otel_auth_token
# Batch processor (export off the request path): queue, batch and delay bounds.
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
# OTEL_BSP_SCHEDULE_DELAY=5000
# OTEL_BSP_EXPORT_TIMEOUT=30000

# ---- context propagation and sampling ----
OTEL_PROPAGATORS=tracecontext,baggage
# Parent-based ratio: honour the upstream decision, sample new roots at the ratio (0..1).
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- mode ----
# false (default): dependency mode, boundary spans only. true: detailed mode, internal spans from detail_span().
TRACING_DETAIL=false

# ---- peer identity (optional): the node name the dependency graph shows for an uninstrumented dependency ----
# Default is the dependency kind (postgres, redis, clickhouse, kafka, s3). Host/port come from POSTGRES_HOST,
# REDIS_HOST, CLICKHOUSE_HOST, KAFKA_BOOTSTRAP_SERVERS, S3_ENDPOINT (the deployment infrastructure variables).
# PEER_SERVICE_POSTGRES=orders-db
# PEER_SERVICE_KAFKA=events-broker
