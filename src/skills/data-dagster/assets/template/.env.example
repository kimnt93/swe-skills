SERVICE_NAME=orders-dagster
ENV_NAME=local
# Source database (read only). SECRET: POSTGRES_PASSWORD or POSTGRES_PASSWORD_FILE.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_PASSWORD=
# Dagster's own run/event storage (a separate database).
DAGSTER_PG_HOST=127.0.0.1
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=
# Where the template writes assets (a mounted volume in production).
DAGSTER_HOME=/opt/dagster/home
OUTPUT_DIR=/var/lib/dagster-output
# Metrics (empty endpoint turns them off).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TOKEN=
