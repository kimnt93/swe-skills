# Identity: the same names in every service (logging, tracing and errors skills). Required.
SERVICE_NAME=orders-dagster
# DEVELOPMENT_ENVIRONMENT, else ENV_NAME, else RUN_ENV; default local.
ENV_NAME=local
# NODE_NAME=            # the Docker host (Swarm: "{{.Node.Hostname}}")
SERVICE_VERSION=
# trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Source database (read only; py-code names). SECRET: POSTGRES_PASSWORD or POSTGRES_PASSWORD_FILE.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Dagster's own run/event storage (a separate database). SECRET: DAGSTER_PG_PASSWORD or ..._FILE.
DAGSTER_PG_HOST=127.0.0.1
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=
# Where the template writes assets (a mounted volume in production).
DAGSTER_HOME=/opt/dagster/home
OUTPUT_DIR=/var/lib/dagster-output

# Telemetry: traces and the dagster_* metrics. An empty endpoint turns both off.
OTEL_SERVICE_NAME=orders-dagster
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# SECRET: OTEL_AUTH_TOKEN or OTEL_AUTH_TOKEN_FILE
OTEL_AUTH_TOKEN=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
TRACING_DETAIL=false

# Error tracking (Sentry or GlitchTip). SECRET: SENTRY_DSN or SENTRY_DSN_FILE. Empty = nothing is sent.
SENTRY_DSN=
