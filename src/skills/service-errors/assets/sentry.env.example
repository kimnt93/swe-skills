# Error tracking (service-errors skill). Sentry-compatible GlitchTip project DSN.
# Unset or empty: nothing is sent. The DSN holds the ingest key: never log it, never print it in errors.
SENTRY_DSN=
# SENTRY_DSN=http://<key>@glitchtip.common.@DOMAIN@/<project id>

# Swarm: mount the secret and point at it instead (the file wins when both are set).
# SENTRY_DSN_FILE=/run/secrets/<service_name>_sentry_dsn

# Used by the events (already part of the service identity):
# ENV_NAME=stg                 -> event environment
# SERVICE_NAME=orders-api     -> tag service_name, release prefix
# SERVICE_VERSION=<image tag>  -> release = <service_name>@<SERVICE_VERSION>
# NODE_NAME=<docker host>      -> server name
