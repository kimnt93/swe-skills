# PostgreSQL (tokio-postgres + deadpool): read from the environment by config::Postgres::load.
# Host, database and user are required; the port has the standard default.
# The password is a SECRET: required, NO default, never committed. Swarm: POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=10
