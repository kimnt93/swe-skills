# Kafka (rdkafka / librdkafka): read from the environment by config::Kafka::load.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# The three SASL variables are required only when the protocol starts with SASL_.
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
# SECRET: no default, never committed (KAFKA_SASL_PASSWORD_FILE in Swarm).
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP=example-service-local
