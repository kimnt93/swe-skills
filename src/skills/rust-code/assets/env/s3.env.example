# S3-compatible object store (RustFS, MinIO, AWS S3; aws-sdk-s3): read by config::S3::load.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=example-local
S3_FORCE_PATH_STYLE=true
# SECRETS: required, NO default, never committed (S3_ACCESS_KEY_FILE / S3_SECRET_KEY_FILE in Swarm).
S3_ACCESS_KEY=
S3_SECRET_KEY=
