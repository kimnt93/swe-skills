# S3-compatible object store (RustFS, MinIO, AWS S3, boto3): every variable is read by settings/s3.py.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=example-local
# path-style addressing (http://host:9000/<bucket>/<key>) is the default for RustFS and MinIO
S3_FORCE_PATH_STYLE=true
# SECRETS: required, NO default, never committed (S3_ACCESS_KEY_FILE / S3_SECRET_KEY_FILE in Swarm).
S3_ACCESS_KEY=
S3_SECRET_KEY=
