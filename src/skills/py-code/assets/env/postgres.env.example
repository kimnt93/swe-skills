# PostgreSQL (psycopg 3): every variable is read from the environment by settings/postgres.py.
# Host, database and user are required; the port has the standard default.
# The password is a SECRET: required, NO default, never committed. In Swarm mount a secret and set
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password instead of POSTGRES_PASSWORD.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_PASSWORD=
# disable (local only) | require | verify-full
POSTGRES_SSLMODE=disable
POSTGRES_POOL_SIZE=10
