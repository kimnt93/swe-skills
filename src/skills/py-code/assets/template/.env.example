# Local development only. Copy to .env (never commit). Names match the deployment-setup infrastructure contract.
# Secrets are blank on purpose: there are no defaults for passwords or keys.
SERVICE_NAME=example-service
ENV_NAME=local
LOG_LEVEL=debug
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
INTERNAL_SERVICE_TOKEN=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
POSTGRES_POOL_SIZE=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP=example-service-local

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=example-local
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
