{
  "uid": "stream-pipelines",
  "title": "Stream Pipelines",
  "description": "Every pipeline from feed ingestion to sink (feed-ws, broker-mqtt, *-transform, *-clickhouse, *-postgres, ...). One service name per pipeline; totals only, no per-message-type labels.",
  "tags": [
    "pipelines",
    "pipelines",
    "kafka"
  ],
  "schemaVersion": 42,
  "version": 1,
  "refresh": "10s",
  "timezone": "utc",
  "time": {
    "from": "now/d",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Mimir",
          "value": "Mimir"
        },
        "options": [],
        "refresh": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(stream_pipeline_running,service_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(stream_pipeline_running,service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Pipelines running",
      "description": "Pipelines reporting running=1 now, out of every pipeline (service) that reported at any point in the selected time range. The arc is running / total.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(stream_pipeline_running{service_name=~\"$service\"} == 1) or on() vector(0)",
          "legendFormat": "Running",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "count(count by (service_name)(last_over_time(stream_pipeline_running{service_name=~\"$service\"}[$__range]))) or on() vector(0)",
          "legendFormat": "Total",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "applyTo": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "mappings": [
              {
                "fieldName": "Value",
                "handlerKey": "max"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total pipelines",
      "description": "Distinct pipelines (services) that reported in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (service_name)(last_over_time(stream_pipeline_running{service_name=~\"$service\"}[$__range]))) or on() vector(0)",
          "legendFormat": "Total pipelines",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Not running",
      "description": "Pipelines seen in the time range that are not reporting running=1 now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(count by (service_name)(last_over_time(stream_pipeline_running{service_name=~\"$service\"}[$__range]))) or on() vector(0)) - (count(stream_pipeline_running{service_name=~\"$service\"} == 1) or on() vector(0))",
          "legendFormat": "Not running",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Restarts in range",
      "description": "Process starts of the selected pipelines.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(stream_pipeline_restarts_total{service_name=~\"$service\"}[$__range])) or on() vector(0)",
          "legendFormat": "Restarts in range",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Errors in range",
      "description": "Kafka enqueue/delivery failures and sink write failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(stream_pipeline_errors_total{service_name=~\"$service\"}[$__range])) or on() vector(0)",
          "legendFormat": "Errors in range",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Consumed in range",
      "description": "status=received: every message consumed (transform, sinks) or received from the feed (ingestion), including the dropped ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(stream_pipeline_messages_total{service_name=~\"$service\",status=\"received\"}[$__range])) or on() vector(0)",
          "legendFormat": "Consumed in range",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Produced in range",
      "description": "status=published: messages transformed or written to the sink, or acknowledged by Kafka (ingestion).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 9,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(stream_pipeline_messages_total{service_name=~\"$service\",status=\"published\"}[$__range])) or on() vector(0)",
          "legendFormat": "Produced in range",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Dropped in range",
      "description": "status=dropped: consumed but intentionally not forwarded (retained MQTT replays, feed control frames, unroutable or undated rows). A subset of consumed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(stream_pipeline_messages_total{service_name=~\"$service\",status=\"dropped\"}[$__range])) or on() vector(0)",
          "legendFormat": "Dropped in range",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Drop rate",
      "description": "Dropped as a share of consumed messages in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 19,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(stream_pipeline_messages_total{service_name=~\"$service\",status=\"dropped\"}[$__range])) / sum(increase(stream_pipeline_messages_total{service_name=~\"$service\",status=\"received\"}[$__range])) or on() vector(0)",
          "legendFormat": "Drop rate",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Pipeline status",
      "description": "One row per pipeline: running=1 while the process is up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service_name)(stream_pipeline_running{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Running",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Consumed messages/s",
      "description": "Per pipeline: messages consumed from the input topic, or received from the feed for ingestion services (includes dropped).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name)(rate(stream_pipeline_messages_total{service_name=~\"$service\",status=\"received\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Produced messages/s",
      "description": "Per pipeline: messages transformed, written to the sink, or acknowledged by Kafka.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name)(rate(stream_pipeline_messages_total{service_name=~\"$service\",status=\"published\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Dropped messages/s",
      "description": "Per pipeline: messages consumed but not forwarded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name)(rate(stream_pipeline_messages_total{service_name=~\"$service\",status=\"dropped\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "95th percentile from input (feed receive or Kafka timestamp) to publish acknowledgement, per pipeline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name)(rate(stream_pipeline_latency_ms_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Payload bytes/s",
      "description": "Bytes produced per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name)(rate(stream_pipeline_payload_bytes_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1,
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Backlog (consumer lag / queue depth)",
      "description": "Transform and sinks: input-topic high watermark minus the newest processed offset. Ingestion: messages waiting in the Go channel for Kafka.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service_name)(stream_pipeline_consumer_lag{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
