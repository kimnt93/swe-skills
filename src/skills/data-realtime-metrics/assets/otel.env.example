# Metrics export: the same variable names in every language (see references/metric-contract.md).
# An empty endpoint disables export; the service must keep working.

# OTLP/HTTP gateway or collector. The client appends /v1/metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-gateway:4318
# Bearer token for the gateway. In Swarm/Kubernetes mount a secret and use OTEL_AUTH_TOKEN_FILE
# (path to the file) instead of the value.
OTEL_AUTH_TOKEN=
OTEL_METRIC_EXPORT_INTERVAL_MS=10000

# The pipeline name: {datasource}-{role}, e.g. feed-ws (ingestion) or feed-ws-transform.
SERVICE_NAME=my-datasource-transform
DEPLOYMENT_ENVIRONMENT=local
# Leave NODE_NAME unset to use the host name (Swarm: "{{.Node.Hostname}}").
# NODE_NAME=
