# Non-secret plane configuration: literal KEY=VALUE (no export, quotes or inline comments).
# Passwords/keys never go here: they are Swarm secrets read through *_FILE.
PUBLIC_DOMAIN=@DOMAIN@
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-gateway:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
TRACING_DETAIL=false
API_REPLICAS=1
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_SSLMODE=require
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=example
CLICKHOUSE_USER=example
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=example
KAFKA_CONSUMER_GROUP=example-worker
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=example-stg
S3_FORCE_PATH_STYLE=true
