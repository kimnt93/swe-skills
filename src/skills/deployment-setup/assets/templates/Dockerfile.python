# Python service managed with uv. Replace `example_api` and the module/command.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /bin/uv
WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY src/ src/
RUN uv sync --locked --no-dev

FROM ${PYTHON_IMAGE} AS runtime
RUN useradd --system --uid 10001 --create-home app \
    && mkdir -p /state \
    && chown 10001:10001 /state
WORKDIR /app
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 scripts/health.sh /app/scripts/health.sh
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TZ=UTC
USER 10001:10001
# Every API listens on 3000 (api-contract skill); Traefik reaches it there.
EXPOSE 3000
# The entrypoint gate waits for the infrastructure named in $HEALTH_DEPS, then execs the application
# (no-op when HEALTH_DEPS is empty). It needs bash in the runtime image.
ENTRYPOINT ["/app/scripts/health.sh", "--wait", "--", "python", "-m", "example_api"]
CMD ["serve"]
