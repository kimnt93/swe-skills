# Local development only. Copy to .env and never commit .env.
# Required secrets are intentionally blank: there are NO defaults for passwords or keys. Compose and
# scripts/health.sh fail until you set them. In Swarm the same values are external secrets read via *_FILE.
RUN_ENV=local
LOG_LEVEL=debug

# --- Tracing (service-tracing skill, references/env.md) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
TRACING_DETAIL=false
# Bearer token for the OTLP gateway, only if the endpoint requires one: a secret, blank, never committed.
OTEL_AUTH_TOKEN=

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_SSLMODE=disable
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=

# --- ClickHouse (native port for drivers, HTTP port for health/HTTP clients) ---
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=example
CLICKHOUSE_USER=example
CLICKHOUSE_PASSWORD=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP=example-local

# --- S3-compatible object store (RustFS) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=example-local
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
