SERVICE_NAME=orders-pw-transform
ENV_NAME=local
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_GROUP_ID=orders-pw-transform
KAFKA_TOPIC_IN=orders.raw
KAFKA_TOPIC_OUT=orders.clean
# SECRET (Swarm: KAFKA_PASSWORD_FILE); empty means PLAINTEXT for local use.
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Window (seconds) for the per-symbol aggregate topic.
WINDOW_SECONDS=60
# Persistence directory (a volume): restart resumes from here.
PERSISTENCE_DIR=/var/lib/pw-state
# Shared stream_pipeline_* metrics: empty endpoint turns them off.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TOKEN=
