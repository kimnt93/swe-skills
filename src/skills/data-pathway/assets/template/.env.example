# Identity: the same names in every service (logging, tracing and errors skills). Required.
SERVICE_NAME=orders-pw-transform
# DEVELOPMENT_ENVIRONMENT, else ENV_NAME, else RUN_ENV; default local.
ENV_NAME=local
# NODE_NAME=            # the Docker host (Swarm: "{{.Node.Hostname}}")
SERVICE_VERSION=
# trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Kafka (py-code names). SECRET: KAFKA_SASL_PASSWORD or KAFKA_SASL_PASSWORD_FILE.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP=orders-pw-transform
KAFKA_TOPIC_IN=orders.raw
KAFKA_TOPIC_OUT=orders.clean

# The job. Window (seconds) for the per-symbol aggregate topic; a volume for restarts.
WINDOW_SECONDS=60
PERSISTENCE_DIR=/var/lib/pw-state

# Telemetry: traces and the stream_pipeline_* metrics. An empty endpoint turns both off.
OTEL_SERVICE_NAME=orders-pw-transform
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# SECRET: OTEL_AUTH_TOKEN or OTEL_AUTH_TOKEN_FILE
OTEL_AUTH_TOKEN=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
TRACING_DETAIL=false

# Error tracking (Sentry or GlitchTip). SECRET: SENTRY_DSN or SENTRY_DSN_FILE. Empty = nothing is sent.
SENTRY_DSN=
