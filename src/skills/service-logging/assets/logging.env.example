# Logging identity: the same variable names in every language (see references/log-format.md).

# The pipeline/service name; also the OpenTelemetry service.name. Required.
SERVICE_NAME=feed-ws
# development_environment: DEVELOPMENT_ENVIRONMENT, else ENV_NAME, else "local".
DEVELOPMENT_ENVIRONMENT=local
# node_name: the Docker/Kubernetes HOST, not the container id. Swarm: NODE_NAME: "{{.Node.Hostname}}".
# Compose with network_mode: host: leave unset (the container hostname is the host's).
# Compose bridge network: NODE_NAME=$(hostname) docker compose up
# NODE_NAME=
# trace, debug, info, warn, error, fatal (warning and critical are accepted aliases)
LOG_LEVEL=info
