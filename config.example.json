{
  "default_agent": "codex",
  "default_engine": "auto",
  "delegation": {
    "engine": "auto",
    "timeout_ms": 300000,
    "yolo": true
  },
  "orca": {
    "enabled": true,
    "binary": "orca"
  },
  "t3": {
    "enabled": true,
    "binary": "t3"
  },
  "agents": {
    "developer-junior": {
      "cli": "codex",
      "model": "o3-mini",
      "reasoning": "medium"
    },
    "developer-senior": {
      "cli": "claude",
      "model": "claude-sonnet-5-5",
      "reasoning": "high"
    },
    "reviewer": {
      "cli": "claude",
      "model": "claude-sonnet-5-5",
      "reasoning": "high"
    },
    "documenter": {
      "cli": "omp",
      "model": "gemini-2.5-flash",
      "reasoning": "low"
    }
  }
}
