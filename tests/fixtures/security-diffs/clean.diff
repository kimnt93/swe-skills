diff --git a/internal/orders/repo.go b/internal/orders/repo.go
index a4db336..84ec046 100644
--- a/internal/orders/repo.go
+++ b/internal/orders/repo.go
@@ -1 +1,14 @@
 package orders
+
+const getOrder = `
+    SELECT id, total
+    FROM orders
+    WHERE id = $1
+`
+
+func (r Repo) Order(ctx context.Context, id string) (Order, error) {
+	var out Order
+	err := r.db.QueryRow(ctx, getOrder, id).Scan(&out.ID, &out.Total)
+	log.Info().Str("order_id", id).Msg("order read")
+	return out, err
+}
